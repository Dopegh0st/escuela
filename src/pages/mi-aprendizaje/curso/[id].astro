---
import Aprendizaje from '../../../layouts/Aprendizaje.astro';
import { getDb, schema } from '../../../lib/db';
import { cursoMatriculado, matriculaDe } from '../../../lib/scope';
import { avisosParaAlumno } from '../../../lib/scope';
import { eq, inArray } from 'drizzle-orm';

export const prerender = false;

const { id } = Astro.params;
const actor = Astro.locals.actor!;
const db = getDb();

// Enrolment is the gate. 404 rather than 403 so a probe cannot confirm the id.
const curso = await cursoMatriculado(db, actor, id!);
if (!curso) return new Response('No encontramos ese curso.', { status: 404 });

const matricula = await matriculaDe(db, actor, curso.id);

const modulos = await db.select().from(schema.modulo)
  .where(eq(schema.modulo.cursoId, curso.id)).orderBy(schema.modulo.orden);
const modIds = modulos.map((m) => m.id);

const lecciones = modIds.length
  ? await db.select().from(schema.leccion)
      .where(inArray(schema.leccion.moduloId, modIds))
      .orderBy(schema.leccion.orden)
  : [];
// Students only ever see published lessons.
const visibles = lecciones.filter((l) => l.estado === 'publicada');

const progreso = matricula
  ? await db.select().from(schema.progreso)
      .where(eq(schema.progreso.matriculaId, matricula.id))
  : [];
const hechas = new Set(progreso.filter((p) => p.completada).map((p) => p.leccionId));

const porModulo = new Map<string, typeof visibles>();
for (const m of modulos) porModulo.set(m.id, []);
for (const l of visibles) porModulo.get(l.moduloId)?.push(l);

const total = visibles.length;
const completas = visibles.filter((l) => hechas.has(l.id)).length;
const pct = total ? Math.round((completas / total) * 100) : 0;
const siguiente = visibles.find((l) => !hechas.has(l.id));
const soloPreview = !matricula;

const sinLeer = (await avisosParaAlumno(db, actor)).filter((a) => !a.leido).length;
---

<Aprendizaje seccion="cursos" sinLeer={sinLeer} title={curso.titulo} volverA="/mi-aprendizaje/" volverTexto="Mis cursos">
  {soloPreview && (
    <p class="preview">Estás viendo tu propio curso como lo ve un estudiante. Tu progreso no se guarda.</p>
  )}

  <header class="cabecera">
    <h1>{curso.titulo}</h1>
    <p class="resumen">{curso.resumen}</p>

    {total > 0 && (
      <div class="progreso">
        <div class="barra-prog"><span style={`width:${pct}%`}></span></div>
        <p class="meta">{completas} de {total} lecciones · {pct}%</p>
      </div>
    )}

    {siguiente && (
      <a class="btn btn-primary" href={`/mi-aprendizaje/leccion/${siguiente.id}/`}>
        {completas === 0 ? 'Empezar el curso' : 'Continuar'} →
      </a>
    )}
    {total > 0 && !siguiente && (
      <p class="terminado">🎉 Terminaste todas las lecciones. Puedes repasarlas cuando quieras.</p>
    )}
  </header>

  {total === 0 ? (
    <div class="vacio">
      <p><strong>Todavía no hay lecciones publicadas.</strong></p>
      <p>Tu profesor está preparando el contenido. Te avisamos apenas esté listo.</p>
    </div>
  ) : (
    <div class="modulos">
      {modulos.map((m, mi) => {
        const lecs = porModulo.get(m.id) ?? [];
        if (lecs.length === 0) return null;
        return (
          <section class="modulo">
            <header class="modulo-head">
              <span class="modulo-num">{mi + 1}</span>
              <h2>{m.titulo}</h2>
              <span class="modulo-meta">
                {lecs.filter((l) => hechas.has(l.id)).length}/{lecs.length}
              </span>
            </header>
            <ol class="lecciones">
              {lecs.map((l) => (
                <li>
                  <a href={`/mi-aprendizaje/leccion/${l.id}/`} class:list={['leccion', hechas.has(l.id) && 'hecha']}>
                    <span class="check" aria-hidden="true">{hechas.has(l.id) ? '✓' : ''}</span>
                    <span class="lec-titulo">{l.titulo}</span>
                    {l.duracionMin && <span class="lec-dur">{l.duracionMin} min</span>}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        );
      })}
    </div>
  )}
</Aprendizaje>

<style>
  .preview {
    background: var(--color-sun-soft); border: 2px solid var(--color-sun);
    border-radius: var(--radius-md); padding: 0.75rem 1rem;
    font-size: var(--text-sm); margin: 0 0 1.5rem;
  }

  .cabecera { margin-bottom: 2rem; }
  h1 { font-size: var(--text-3xl); margin: 0 0 0.5rem; }
  .resumen { color: var(--color-ink-soft); font-size: var(--text-lg); margin: 0 0 1.5rem; max-width: 58ch; }
  .progreso { margin-bottom: 1.5rem; max-width: 30rem; }
  .meta { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0.5rem 0 0; }
  .terminado { color: var(--color-accent); font-weight: 700; margin: 0; }

  .barra-prog { height: 10px; border-radius: var(--radius-pill); background: var(--color-sunken); overflow: hidden; }
  .barra-prog span { display: block; height: 100%; background: var(--color-accent); border-radius: var(--radius-pill); }

  .vacio {
    background: var(--color-raised); border: 2px dashed var(--color-border-strong);
    border-radius: var(--radius-lg); padding: 2.5rem 1.5rem; text-align: center;
  }
  .vacio p { margin: 0 0 0.25rem; color: var(--color-ink-soft); }

  .modulos { display: grid; gap: 1.25rem; }
  .modulo { background: var(--color-raised); border: 2px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
  .modulo-head { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-sunken); }
  .modulo-num {
    width: 1.75rem; height: 1.75rem; flex: none; border-radius: var(--radius-pill);
    background: var(--color-primary); color: #fff; display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-xs);
  }
  .modulo-head h2 { font-size: var(--text-base); margin: 0; flex: 1; }
  .modulo-meta { font-size: var(--text-xs); color: var(--color-ink-faint); font-weight: 700; }

  .lecciones { list-style: none; margin: 0; padding: 0; counter-reset: lec; }
  .leccion {
    display: flex; align-items: center; gap: 0.875rem;
    padding: 0.875rem 1.25rem; border-top: 1px solid var(--color-border);
    text-decoration: none; color: inherit;
  }
  .leccion:hover { background: var(--color-sunken); }
  .check {
    width: 1.5rem; height: 1.5rem; flex: none; border-radius: var(--radius-pill);
    border: 2px solid var(--color-border-strong);
    display: grid; place-items: center; font-size: var(--text-xs); font-weight: 800;
    color: transparent;
  }
  .hecha .check { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .lec-titulo { flex: 1; font-size: var(--text-sm); font-weight: 600; }
  .hecha .lec-titulo { color: var(--color-ink-faint); }
  .lec-dur { font-size: var(--text-xs); color: var(--color-ink-faint); white-space: nowrap; }
</style>
