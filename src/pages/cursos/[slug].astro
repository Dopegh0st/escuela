---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE, waLink, MINUTOS_PRUEBA } from '../../config';

export async function getStaticPaths() {
  const cursos = await getCollection('cursos', ({ data }) => data.publicado);
  return cursos.map((curso) => ({ params: { slug: curso.id }, props: { curso } }));
}

const { curso } = Astro.props;
const d = curso.data;
const { Content } = await render(curso);

const MATERIA_LABEL: Record<string, string> = {
  ingles: 'Inglés',
  musica: 'Música',
  programacion: 'Programación',
  'apoyo-escolar': 'Apoyo escolar',
};
const NIVEL_LABEL: Record<string, string> = {
  principiante: 'Desde cero',
  intermedio: 'Intermedio',
  avanzado: 'Avanzado',
  todos: 'Todos los niveles',
};

const formato =
  d.formato === 'individual'
    ? 'Clase individual'
    : `Grupo de ${d.cupoMin} a ${d.cupoMax} personas`;

// schema.org Course. Deliberately NO aggregateRating: there are no real
// reviews yet, and self-serving review markup breaches Google's policy.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: d.titulo,
  description: d.resumen,
  inLanguage: 'es-EC',
  provider: { '@type': 'EducationalOrganization', name: SITE.name },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'online',
    courseWorkload: `PT${d.clasesPorSemana * d.duracionMin}M`,
    instructor: { '@type': 'Person', name: d.profesor },
  },
  offers: {
    '@type': 'Offer',
    price: d.precio,
    priceCurrency: 'USD',
    category: d.precioUnidad === 'mes' ? 'Suscripción mensual' : 'Por clase',
    availability: 'https://schema.org/InStock',
  },
};
---

<Base title={d.titulo} description={d.resumen}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="curso-hero" style={`--desde:${d.portada.desde}; --hasta:${d.portada.hasta}`}>
      <div class="container-page hero-grid">
        <div>
          <nav class="miga" aria-label="Migas de pan">
            <a href="/cursos/">Cursos</a> <span aria-hidden="true">/</span>
            <span>{MATERIA_LABEL[d.materia]}</span>
          </nav>
          <h1>{d.titulo}</h1>
          <p class="resumen">{d.resumen}</p>
          <div class="autor">
            <span class="avatar">{d.profesor.charAt(0)}</span>
            <div>
              <p class="autor-nombre">Con {d.profesor}</p>
              <p class="autor-nivel">{NIVEL_LABEL[d.nivel]}</p>
            </div>
          </div>
        </div>
        <div class="portada" aria-hidden={d.imagen ? undefined : 'true'}>
          {d.imagen ? (
            <Image
              src={d.imagen}
              alt={d.imagenAlt ?? ''}
              widths={[600, 1000]}
              sizes="(min-width: 768px) 460px, 100vw"
              loading="eager"
              class="portada-img"
            />
          ) : (
            <span>{d.portada.emoji}</span>
          )}
        </div>
      </div>
    </header>

    <div class="container-page cuerpo">
      <div class="prosa">
        <Content />
      </div>

      <aside class="panel">
        <div class="card panel-card">
          <p class="panel-precio">
            <span class="sim">$</span>{d.precio}<span class="unidad">/ {d.precioUnidad}</span>
          </p>
          <dl class="panel-datos">
            <div><dt>Formato</dt><dd>{formato}</dd></div>
            <div><dt>Frecuencia</dt><dd>{d.clasesPorSemana}× por semana</dd></div>
            <div><dt>Duración</dt><dd>{d.duracionMin} minutos</dd></div>
            <div><dt>Profesor</dt><dd>{d.profesor}</dd></div>
            <div><dt>Nivel</dt><dd>{NIVEL_LABEL[d.nivel]}</dd></div>
          </dl>
          <a
            class="btn btn-primary ancho"
            href={waLink(`Hola, quiero mi primera clase gratis de "${d.titulo}" con ${d.profesor}.`)}
          >
            Primera clase gratis
          </a>
          <a class="btn btn-secondary ancho" href={waLink(`Hola, tengo una pregunta sobre "${d.titulo}".`)}>
            Tengo una pregunta
          </a>
          <p class="panel-nota">
            {MINUTOS_PRUEBA} min a solas con {d.profesor}, sin tarjeta y sin compromiso.
          </p>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .curso-hero {
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--desde) 12%, var(--color-surface)),
      var(--color-surface));
    padding-block: 2.5rem 3rem;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }

  .miga { font-size: var(--text-sm); color: var(--color-ink-faint); margin-bottom: 0.875rem; }
  .miga a { color: var(--color-primary); text-decoration: none; }
  .miga span { margin-inline: 0.25rem; }

  h1 { font-size: var(--text-3xl); margin: 0 0 0.875rem; }
  .resumen { font-size: var(--text-lg); color: var(--color-ink-soft); margin: 0 0 1.75rem; max-width: 48ch; }

  .autor { display: flex; align-items: center; gap: 0.75rem; }
  .avatar {
    display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft); color: var(--color-accent);
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-lg);
  }
  .autor-nombre { font-weight: 700; margin: 0; font-family: var(--font-display); }
  .autor-nivel { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0; }

  .portada {
    display: none;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, var(--desde), var(--hasta));
  }
  .portada span { font-size: 5rem; filter: drop-shadow(0 3px 10px rgb(0 0 0 / 0.25)); }
  .portada-img { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-xl); }

  .cuerpo {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: 3rem;
    align-items: start;
  }

  /* The article body -- this is the "blog post" half of the idea. */
  .prosa { max-width: 68ch; }
  .prosa :global(h2) {
    font-size: var(--text-2xl);
    margin: 2.5rem 0 0.875rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .prosa :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: none; }
  .prosa :global(p) { margin: 0 0 1.125rem; font-size: var(--text-lg); }
  .prosa :global(ul) { margin: 0 0 1.5rem; padding-left: 0; list-style: none; }
  .prosa :global(li) { position: relative; padding-left: 1.75rem; margin-bottom: 0.625rem; font-size: var(--text-lg); }
  .prosa :global(li)::before {
    content: '';
    position: absolute; left: 0; top: 0.7em;
    width: 0.5rem; height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
  }

  .panel-card { padding: 1.5rem; }
  .panel-precio {
    font-family: var(--font-display); font-weight: 800;
    font-size: 2.75rem; line-height: 1; margin: 0 0 1.25rem;
    letter-spacing: -0.03em;
  }
  .sim { font-size: var(--text-lg); vertical-align: super; }
  .unidad { font-size: var(--text-base); font-weight: 500; color: var(--color-ink-faint); letter-spacing: 0; margin-left: 0.25rem; }

  .panel-datos { margin: 0 0 1.5rem; display: grid; gap: 0.625rem; }
  .panel-datos > div {
    display: flex; justify-content: space-between; gap: 1rem;
    padding-bottom: 0.625rem; border-bottom: 1px solid var(--color-border);
  }
  .panel-datos > div:last-child { border-bottom: none; padding-bottom: 0; }
  .panel-datos dt { color: var(--color-ink-faint); font-size: var(--text-sm); margin: 0; }
  .panel-datos dd { margin: 0; font-weight: 600; font-size: var(--text-sm); text-align: right; }

  .ancho { width: 100%; margin-bottom: 0.625rem; }
  .panel-nota { text-align: center; font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0.75rem 0 0; }

  @media (min-width: 768px) {
    h1 { font-size: var(--text-4xl); }
    .hero-grid { grid-template-columns: 1.4fr 1fr; }
    .portada { display: grid; }
  }
  @media (min-width: 1024px) {
    .cuerpo { grid-template-columns: 1fr 20rem; gap: 4rem; }
    .panel { position: sticky; top: 88px; }
  }
</style>
