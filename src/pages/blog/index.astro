---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';

const posts = (await getCollection('blog', ({ data }) => data.publicado))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const CAT_LABEL: Record<string, string> = {
  ingles: 'Inglés',
  musica: 'Música',
  programacion: 'Programación',
  'apoyo-escolar': 'Apoyo escolar',
  consejos: 'Consejos',
};

const fmt = (d: Date) =>
  d.toLocaleDateString('es-EC', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Blog"
  description="Consejos prácticos sobre aprender inglés, música y programación en Ecuador, y sobre acompañar a los niños en el colegio."
>
  <section class="cabecera-pagina">
    <div class="container-page">
      <h1>Cosas que vale la pena saber</h1>
      <p class="lede">
        Escribimos sobre lo que nos preguntan en WhatsApp. Sin relleno y sin
        vendernos en cada párrafo.
      </p>
    </div>
  </section>

  <section class="container-page listado">
    {/* Only the first row animates in. With a dozen posts, gating every card on
        a scroll observer leaves the page opening on three cards above a screen
        of blank space — and anything that never scrolls (a preview, a thumbnail,
        a reader who stops) never sees the rest at all. */}
    <div class="grid-blog">
      {posts.map((post, i) => (
        <article class:list={['post', i < 3 && 'animate-on-scroll', i < 3 && `delay-${i + 1}`]} style={`--c:${post.data.color}`}>
          <a href={`/blog/${post.id}/`} class="post-portada" aria-hidden="true" tabindex="-1">
            <span>{post.data.emoji}</span>
          </a>
          <div class="post-cuerpo">
            <div class="post-meta">
              <span class="post-cat">{CAT_LABEL[post.data.categoria]}</span>
              <span class="post-sep">·</span>
              <span>{post.data.minutosLectura} min de lectura</span>
            </div>
            <h2><a href={`/blog/${post.id}/`}>{post.data.titulo}</a></h2>
            <p class="post-resumen">{post.data.resumen}</p>
            <div class="post-pie">
              <span class="post-autor">Por {post.data.autor}</span>
              <time datetime={post.data.fecha.toISOString()}>{fmt(post.data.fecha)}</time>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaFinal
    titulo="¿Tienes una pregunta que no está aquí?"
    texto="Escríbenos por WhatsApp. Si la pregunta se repite, probablemente termine siendo el próximo artículo."
    mensaje="Hola, tengo una pregunta."
  />
</Base>

<style>
  .listado { padding-block: 3rem 1rem; }
  .grid-blog { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 700px) { .grid-blog { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid-blog { grid-template-columns: repeat(3, 1fr); } }

  .post {
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .post:hover { transform: translateY(-4px); border-color: var(--c); box-shadow: var(--shadow-lg); }

  .post-portada {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    background: color-mix(in srgb, var(--c) 14%, var(--color-surface));
    text-decoration: none;
  }
  .post-portada span { font-size: 2.75rem; }

  .post-cuerpo { padding: 1.375rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .post-meta { display: flex; gap: 0.5rem; align-items: center; font-size: var(--text-xs); color: var(--color-ink-faint); }
  .post-cat { color: var(--c); font-weight: 800; font-family: var(--font-display); }
  .post h2 { font-size: var(--text-lg); margin: 0; line-height: 1.3; }
  .post h2 a { color: var(--color-ink); text-decoration: none; }
  .post h2 a:hover { color: var(--c); }
  .post-resumen { color: var(--color-ink-soft); font-size: var(--text-sm); margin: 0; flex: 1; }
  .post-pie {
    display: flex; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;
    font-size: var(--text-xs); color: var(--color-ink-faint);
    padding-top: 0.875rem; border-top: 1px solid var(--color-border); margin-top: 0.25rem;
  }
  .post-autor { font-weight: 700; color: var(--color-ink-soft); }
</style>
