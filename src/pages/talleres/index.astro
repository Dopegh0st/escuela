---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { waLink } from '../../config';

const todos = (await getCollection('talleres', ({ data }) => data.publicado))
  .sort((a, b) => a.data.fecha.valueOf() - b.data.fecha.valueOf());

// Ecuador is UTC-5 year-round with no DST, so a plain date comparison is safe.
const hoy = new Date();
const proximos = todos.filter((t) => t.data.fecha >= hoy);
const pasados = todos.filter((t) => t.data.fecha < hoy);

const fmt = (d: Date) =>
  d.toLocaleDateString('es-EC', { weekday: 'long', day: 'numeric', month: 'long' });
---

<Base
  title="Talleres"
  description="Talleres y charlas en vivo, la mayoría gratis. Para conocernos sin compromiso antes de tomar un curso."
>
  <section class="cabecera-pagina">
    <div class="container-page">
      <h1>Talleres y charlas</h1>
      <p class="lede">
        Sesiones en vivo, casi siempre gratis, para conocernos sin compromiso. Una
        hora, un tema concreto y espacio de verdad para preguntar.
      </p>
    </div>
  </section>

  <section class="container-page listado">
    {proximos.length === 0 ? (
      <div class="vacio">
        <span class="vacio-emoji" aria-hidden="true">📅</span>
        <h2>Ahora mismo no hay talleres programados</h2>
        <p>Escríbenos y te avisamos apenas anunciemos el próximo.</p>
        <a class="btn btn-whatsapp" href={waLink('Hola, quiero que me avisen del próximo taller.')}>
          Avísenme del próximo
        </a>
      </div>
    ) : (
      <div class="grid-talleres">
        {proximos.map((t, i) => (
          <article class:list={['taller', 'animate-on-scroll', `delay-${(i % 3) + 1}`]} style={`--c:${t.data.color}`}>
            <a href={`/talleres/${t.id}/`} class="taller-portada" aria-hidden="true" tabindex="-1">
              <span>{t.data.emoji}</span>
            </a>
            <div class="taller-cuerpo">
              <div class="taller-badges">
                {t.data.precio === 0
                  ? <span class="badge badge-sun">Gratis</span>
                  : <span class="badge badge-primary">${t.data.precio}</span>}
                <span class="badge">{t.data.modalidad === 'online' ? 'En línea' : 'Presencial'}</span>
              </div>
              <h2><a href={`/talleres/${t.id}/`}>{t.data.titulo}</a></h2>
              <p class="taller-fecha">
                <time datetime={t.data.fecha.toISOString()}>{fmt(t.data.fecha)}</time>
                · {t.data.hora} · {t.data.duracionMin} min
              </p>
              <p class="taller-resumen">{t.data.resumen}</p>
              <p class="taller-para">{t.data.paraQuien}</p>
              <div class="taller-pie">
                <span class="taller-profe">Con {t.data.profesor}</span>
                <a class="taller-link" href={`/talleres/${t.id}/`}>Ver detalles →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    {pasados.length > 0 && (
      <div class="pasados">
        <h2>Talleres anteriores</h2>
        <ul>
          {pasados.map((t) => (
            <li>
              <a href={`/talleres/${t.id}/`}>{t.data.titulo}</a>
              <span> · {fmt(t.data.fecha)}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <CtaFinal
    titulo="¿Te interesa un taller sobre algo puntual?"
    texto="Dinos qué tema te serviría. Varios de estos talleres salieron justamente de una pregunta por WhatsApp."
    mensaje="Hola, me gustaría un taller sobre..."
  />
</Base>

<style>
  .listado { padding-block: 3rem 1rem; }
  .grid-talleres { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 700px) { .grid-talleres { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .grid-talleres { grid-template-columns: repeat(3, 1fr); } }

  .taller {
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .taller:hover { transform: translateY(-4px); border-color: var(--c); box-shadow: var(--shadow-lg); }
  .taller-portada {
    display: grid; place-items: center;
    aspect-ratio: 16 / 7;
    background: color-mix(in srgb, var(--c) 16%, var(--color-surface));
    text-decoration: none;
  }
  .taller-portada span { font-size: 2.75rem; }
  .taller-cuerpo { padding: 1.375rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .taller-badges { display: flex; gap: 0.375rem; flex-wrap: wrap; margin-bottom: 0.25rem; }
  .taller h2 { font-size: var(--text-lg); margin: 0; line-height: 1.3; }
  .taller h2 a { color: var(--color-ink); text-decoration: none; }
  .taller h2 a:hover { color: var(--c); }
  .taller-fecha { font-size: var(--text-sm); color: var(--c); font-weight: 700; margin: 0; text-transform: capitalize; }
  .taller-resumen { color: var(--color-ink-soft); font-size: var(--text-sm); margin: 0; flex: 1; }
  .taller-para { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0; }
  .taller-pie {
    display: flex; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;
    padding-top: 0.875rem; border-top: 1px solid var(--color-border); margin-top: 0.25rem;
  }
  .taller-profe { font-size: var(--text-sm); color: var(--color-ink-faint); }
  .taller-link { color: var(--c); font-weight: 700; text-decoration: none; font-size: var(--text-sm); font-family: var(--font-display); }

  .vacio {
    text-align: center;
    padding: 3.5rem 1.5rem;
    border: 2px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-sunken);
  }
  .vacio-emoji { font-size: 2.75rem; }
  .vacio h2 { font-size: var(--text-xl); margin: 0.75rem 0 0.5rem; }
  .vacio p { color: var(--color-ink-soft); margin: 0 0 1.5rem; }

  .pasados { margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .pasados h2 { font-size: var(--text-lg); margin: 0 0 0.875rem; }
  .pasados ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .pasados li { color: var(--color-ink-faint); font-size: var(--text-sm); }
  .pasados a { color: var(--color-ink-soft); font-weight: 600; }
</style>
