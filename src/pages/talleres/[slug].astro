---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { SITE, waLink } from '../../config';

export async function getStaticPaths() {
  const talleres = await getCollection('talleres', ({ data }) => data.publicado);
  return talleres.map((taller) => ({ params: { slug: taller.id }, props: { taller } }));
}

const { taller } = Astro.props;
const d = taller.data;
const { Content } = await render(taller);

const fmtLargo = (x: Date) =>
  x.toLocaleDateString('es-EC', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

const yaPaso = d.fecha < new Date();

const profe = (await getCollection('profesores')).find((p) => p.data.nombre === d.profesor);

const otros = (await getCollection('talleres', ({ data }) => data.publicado))
  .filter((t) => t.id !== taller.id && t.data.fecha >= new Date())
  .sort((a, b) => a.data.fecha.valueOf() - b.data.fecha.valueOf())
  .slice(0, 2);

const reserva = `Hola, quiero reservar un cupo para "${d.titulo}" del ${fmtLargo(d.fecha)}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: d.titulo,
  description: d.resumen,
  inLanguage: 'es-EC',
  // Ecuador is UTC-5 year-round, no DST, so the offset is a constant.
  startDate: `${d.fecha.toISOString().slice(0, 10)}T${d.hora}:00-05:00`,
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'VirtualLocation', url: SITE.url },
  organizer: { '@type': 'EducationalOrganization', name: SITE.name },
  performer: { '@type': 'Person', name: d.profesor },
  offers: {
    '@type': 'Offer',
    price: d.precio,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: SITE.url,
  },
};
---

<Base title={d.titulo} description={d.resumen}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="taller-hero" style={`--c:${d.color}`}>
      <div class="container-page">
        <nav class="miga" aria-label="Migas de pan">
          <a href="/talleres/">Talleres</a> <span aria-hidden="true">/</span>
          <span>{d.modalidad === 'online' ? 'En línea' : 'Presencial'}</span>
        </nav>
        <div class="hero-badges">
          {d.precio === 0
            ? <span class="badge badge-sun">Gratis</span>
            : <span class="badge badge-primary">${d.precio}</span>}
          {yaPaso && <span class="badge">Ya pasó</span>}
        </div>
        <h1>{d.titulo}</h1>
        <p class="resumen">{d.resumen}</p>
      </div>
    </header>

    <!-- Stats bar, as in the reference: the facts someone needs before reading. -->
    <div class="barra-datos" style={`--c:${d.color}`}>
      <div class="container-page barra-grid">
        <div><span class="bd-etiqueta">Cuándo</span><span class="bd-valor">{fmtLargo(d.fecha)}</span></div>
        <div><span class="bd-etiqueta">Hora</span><span class="bd-valor">{d.hora} · {d.duracionMin} min</span></div>
        <div><span class="bd-etiqueta">Dónde</span><span class="bd-valor">{d.modalidad === 'online' ? 'En línea, en vivo' : 'Presencial'}</span></div>
        <div><span class="bd-etiqueta">Con</span><span class="bd-valor">{d.profesor}</span></div>
      </div>
    </div>

    <div class="container-page cuerpo">
      <div class="prosa">
        <Content />
      </div>

      <aside class="lateral">
        <div class="panel-reserva" style={`--c:${d.color}`}>
          <p class="reserva-precio">{d.precio === 0 ? 'Gratis' : `$${d.precio}`}</p>
          {d.cupos && <p class="reserva-cupos">Cupo limitado a {d.cupos} personas</p>}
          <dl class="reserva-datos">
            <div><dt>Fecha</dt><dd>{fmtLargo(d.fecha)}</dd></div>
            <div><dt>Hora</dt><dd>{d.hora}</dd></div>
            <div><dt>Duración</dt><dd>{d.duracionMin} minutos</dd></div>
            <div><dt>Para quién</dt><dd>{d.paraQuien}</dd></div>
          </dl>
          {yaPaso ? (
            <>
              <p class="reserva-paso">Este taller ya pasó.</p>
              <a class="btn btn-secondary ancho" href={waLink('Hola, quiero que me avisen del próximo taller.')}>
                Avísenme del próximo
              </a>
            </>
          ) : (
            <a class="btn btn-primary ancho" href={waLink(reserva)}>
              Reservar mi cupo
            </a>
          )}
          <p class="reserva-nota">Confirmamos el cupo y el enlace por WhatsApp.</p>
        </div>

        {profe && (
          <a href={`/profesores/${profe.id}/`} class="panel-profe" style={`--c:${profe.data.color}`}>
            <div class="pp-foto" aria-hidden="true">{profe.data.nombre.charAt(0)}</div>
            <div>
              <p class="pp-nombre">{profe.data.nombre}</p>
              <p class="pp-titular">{profe.data.titular}</p>
              <span class="pp-link">Ver su perfil →</span>
            </div>
          </a>
        )}
      </aside>
    </div>

    {otros.length > 0 && (
      <section class="section-alt">
        <div class="container-page mas">
          <h2 class="animate-on-scroll">Otros talleres</h2>
          <div class="grid-mas">
            {otros.map((o, i) => (
              <a href={`/talleres/${o.id}/`} class:list={['mini', 'animate-on-scroll', `delay-${i + 1}`]} style={`--c:${o.data.color}`}>
                <span class="mini-emoji" aria-hidden="true">{o.data.emoji}</span>
                <div>
                  <h3>{o.data.titulo}</h3>
                  <p>{fmtLargo(o.data.fecha)} · {o.data.precio === 0 ? 'Gratis' : `$${o.data.precio}`}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <CtaFinal
    titulo="¿Prefieres una clase en vez de un taller?"
    texto="La primera clase es gratis, uno a uno con el profesor que escojas."
    mensaje="Hola, quiero mi primera clase gratis."
  />
</Base>

<style>
  .taller-hero {
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--c) 16%, var(--color-surface)),
      var(--color-surface));
    padding-block: 2.5rem 2.5rem;
  }
  .miga { font-size: var(--text-sm); color: var(--color-ink-faint); margin-bottom: 0.875rem; }
  .miga a { color: var(--c); text-decoration: none; font-weight: 600; }
  .miga span { margin-inline: 0.25rem; }
  .hero-badges { display: flex; gap: 0.5rem; margin-bottom: 0.875rem; }
  h1 { font-size: var(--text-3xl); margin: 0 0 0.875rem; max-width: 22ch; }
  @media (min-width: 768px) { h1 { font-size: var(--text-4xl); } }
  .resumen { font-size: var(--text-lg); color: var(--color-ink-soft); margin: 0; max-width: 54ch; }

  .barra-datos {
    background: var(--color-deep);
    color: #fff;
    padding-block: 1.5rem;
  }
  .barra-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  @media (min-width: 860px) { .barra-grid { grid-template-columns: repeat(4, 1fr); } }
  .barra-grid > div { display: flex; flex-direction: column; gap: 0.125rem; }
  .bd-etiqueta { font-size: var(--text-xs); color: #a79fd0; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; }
  .bd-valor { font-family: var(--font-display); font-weight: 800; text-transform: capitalize; }

  .cuerpo { display: grid; grid-template-columns: 1fr; gap: 2.5rem; padding-block: 3rem; align-items: start; }
  @media (min-width: 1024px) { .cuerpo { grid-template-columns: 1fr 20rem; gap: 4rem; } .lateral { position: sticky; top: 88px; } }

  .panel-reserva {
    background: var(--color-raised);
    border: 2px solid var(--c);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .reserva-precio {
    font-family: var(--font-display); font-weight: 800;
    font-size: 2.5rem; line-height: 1; margin: 0 0 0.25rem; color: var(--c);
  }
  .reserva-cupos { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0 0 1.25rem; font-weight: 600; }
  .reserva-datos { margin: 0 0 1.5rem; display: grid; gap: 0.625rem; }
  .reserva-datos > div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.625rem; border-bottom: 1px solid var(--color-border); }
  .reserva-datos > div:last-child { border-bottom: none; padding-bottom: 0; }
  .reserva-datos dt { color: var(--color-ink-faint); font-size: var(--text-sm); margin: 0; flex: none; }
  .reserva-datos dd { margin: 0; font-weight: 600; font-size: var(--text-sm); text-align: right; }
  .ancho { width: 100%; }
  .reserva-paso { font-size: var(--text-sm); color: var(--color-ink-soft); margin: 0 0 0.75rem; text-align: center; }
  .reserva-nota { text-align: center; font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0.875rem 0 0; }

  .panel-profe {
    display: flex; gap: 0.875rem; align-items: center;
    margin-top: 1.25rem; padding: 1.25rem;
    background: var(--color-sunken);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none; color: inherit;
  }
  .panel-profe:hover { border-color: var(--c); }
  .pp-foto {
    width: 3rem; height: 3rem; flex: none;
    border-radius: var(--radius-pill);
    background: var(--c); color: #fff;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 800;
  }
  .pp-nombre { font-family: var(--font-display); font-weight: 800; margin: 0; }
  .pp-titular { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0 0 0.25rem; }
  .pp-link { font-size: var(--text-sm); color: var(--c); font-weight: 700; }

  .mas { padding-block: 3.5rem; }
  .mas h2 { font-size: var(--text-2xl); margin: 0 0 1.5rem; }
  .grid-mas { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 768px) { .grid-mas { grid-template-columns: repeat(2, 1fr); } }
  .mini {
    display: flex; gap: 0.875rem; align-items: flex-start;
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    text-decoration: none; color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .mini:hover { transform: translateY(-3px); border-color: var(--c); }
  .mini-emoji { font-size: 1.75rem; }
  .mini h3 { font-size: var(--text-base); margin: 0 0 0.25rem; line-height: 1.3; }
  .mini p { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0; text-transform: capitalize; }
</style>
