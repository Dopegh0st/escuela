---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';

const profes = (await getCollection('profesores')).sort((a, b) => a.data.orden - b.data.orden);

const MATERIA_LABEL: Record<string, string> = {
  ingles: 'Inglés',
  musica: 'Música',
  programacion: 'Programación',
  'apoyo-escolar': 'Apoyo escolar',
};
---

<Base
  title="Profesores"
  description="Conoce a los profesores de la escuela: personas con nombre, apellido y título. Puedes hablar con ellos antes de inscribirte."
>
  <section class="cabecera-pagina">
    <div class="container-page">
      <h1>Quiénes te enseñan</h1>
      <p class="lede">
        Somos pocos y eso es a propósito. Cada profesor tiene nombre, título y una
        manera propia de enseñar — puedes leerla antes de decidir, y hablar con
        ellos antes de pagar nada.
      </p>
    </div>
  </section>

  <section class="container-page listado">
    <div class="grid-profes">
      {profes.map((p, i) => (
        <article
          class:list={['tarjeta', 'animate-on-scroll', `delay-${(i % 3) + 1}`, !p.data.disponible && 'tarjeta-pronto']}
          style={`--c:${p.data.color}`}
        >
          <a href={`/profesores/${p.id}/`} class="tarjeta-link">
            {p.data.foto ? (
              <Image src={p.data.foto} alt={p.data.fotoAlt ?? ''} widths={[160, 320]}
                     sizes="120px" loading="lazy" class="tarjeta-foto-img" />
            ) : (
              <div class="tarjeta-foto" aria-hidden="true">{p.data.nombre.charAt(0)}</div>
            )}
            <h2>{p.data.nombre}</h2>
          </a>
          <p class="tarjeta-titular">{p.data.titular}</p>
          <p class="tarjeta-resumen">{p.data.resumen}</p>

          <ul class="tarjeta-materias">
            {p.data.materias.map((m) => <li>{MATERIA_LABEL[m]}</li>)}
          </ul>

          <div class="tarjeta-pie">
            {p.data.disponible
              ? <a class="tarjeta-cta" href={`/profesores/${p.id}/`}>Ver perfil →</a>
              : <span class="badge badge-sun">Cupos pronto</span>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaFinal
    titulo="¿Quieres hablar con alguno?"
    texto="Escríbenos y coordinamos una primera clase gratis con el profesor que prefieras."
    mensaje="Hola, quiero hablar con uno de los profesores."
  />
</Base>

<style>
  .listado { padding-block: 3rem 1rem; }
  .grid-profes { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 700px) { .grid-profes { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid-profes { grid-template-columns: repeat(3, 1fr); } }

  .tarjeta {
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .tarjeta:hover { transform: translateY(-4px); border-color: var(--c); box-shadow: var(--shadow-lg); }
  .tarjeta-pronto { border-style: dashed; }
  .tarjeta-link { text-decoration: none; color: inherit; }
  .tarjeta-foto,
  .tarjeta-foto-img {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
    object-fit: cover;
  }
  .tarjeta-foto {
    background: var(--c);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-2xl);
  }
  .tarjeta h2 { font-size: var(--text-xl); margin: 0 0 0.125rem; }
  .tarjeta-link:hover h2 { color: var(--c); }
  .tarjeta-titular { color: var(--c); font-weight: 700; font-size: var(--text-sm); margin: 0 0 0.75rem; font-family: var(--font-display); }
  .tarjeta-resumen { color: var(--color-ink-soft); font-size: var(--text-sm); margin: 0 0 1rem; flex: 1; }
  .tarjeta-materias { display: flex; flex-wrap: wrap; gap: 0.375rem; list-style: none; padding: 0; margin: 0 0 1rem; }
  .tarjeta-materias li {
    font-size: var(--text-xs);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    background: var(--color-sunken);
    color: var(--color-ink-soft);
    border: 1px solid var(--color-border);
  }
  .tarjeta-pie { padding-top: 0.875rem; border-top: 1px solid var(--color-border); }
  .tarjeta-cta { color: var(--c); font-weight: 700; text-decoration: none; font-size: var(--text-sm); font-family: var(--font-display); }
  .tarjeta-cta:hover { text-decoration: underline; }
</style>
