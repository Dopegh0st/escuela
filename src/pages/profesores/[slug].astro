---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { SITE, waLink, MINUTOS_PRUEBA } from '../../config';

export async function getStaticPaths() {
  const profes = await getCollection('profesores');
  return profes.map((profe) => ({ params: { slug: profe.id }, props: { profe } }));
}

const { profe } = Astro.props;
const d = profe.data;
const { Content } = await render(profe);

const MATERIA_LABEL: Record<string, string> = {
  ingles: 'Inglés',
  musica: 'Música',
  programacion: 'Programación',
  'apoyo-escolar': 'Apoyo escolar',
};

// Courses this teacher actually teaches.
const cursos = (await getCollection('cursos', ({ data }) => data.publicado))
  .filter((c) => c.data.profesor === d.nombre)
  .sort((a, b) => a.data.orden - b.data.orden);

const otros = (await getCollection('profesores'))
  .filter((p) => p.id !== profe.id)
  .sort((a, b) => a.data.orden - b.data.orden);

// schema.org Person. Credentials are the whole point of this page: Google holds
// health-adjacent content to a higher E-E-A-T standard, and a named, verifiable
// professional is also the strongest trust signal for an Ecuadorian parent.
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: d.nombre,
  jobTitle: d.titular,
  description: d.resumen,
  worksFor: { '@type': 'EducationalOrganization', name: SITE.name },
  knowsAbout: d.especialidades,
};
if (d.credencial) {
  jsonLd.hasCredential = {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: d.credencial,
  };
}
---

<Base title={d.nombre} description={d.resumen}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="perfil-hero" style={`--c:${d.color}`}>
      <div class="container-page hero-grid">
        <div>
          <nav class="miga" aria-label="Migas de pan">
            <a href="/profesores/">Profesores</a> <span aria-hidden="true">/</span>
            <span>{d.nombre}</span>
          </nav>
          <h1>{d.nombre}</h1>
          <p class="titular">{d.titular}</p>
          <p class="resumen">{d.resumen}</p>

          {d.credencial && (
            <div class="credencial">
              <span class="cred-icono" aria-hidden="true">🎓</span>
              <div>
                <p class="cred-titulo">{d.credencial}</p>
                {d.registro && <p class="cred-registro">{d.registro}</p>}
              </div>
            </div>
          )}

          <div class="hero-cta">
            {d.disponible ? (
              <a class="btn btn-primary" href={waLink(`Hola, quiero mi primera clase gratis de ${MINUTOS_PRUEBA} minutos con ${d.nombre}.`)}>
                Clase gratis con {d.nombre}
              </a>
            ) : (
              <a class="btn btn-secondary" href={waLink(`Hola, quiero que me avisen cuando ${d.nombre} abra cupos.`)}>
                Avísenme cuando abra
              </a>
            )}
          </div>

          {!d.disponible && d.notaNoDisponible && (
            <p class="nota-pronto">{d.notaNoDisponible}</p>
          )}
        </div>

        <div class="perfil-visual">
          {d.foto ? (
            <Image src={d.foto} alt={d.fotoAlt ?? `Foto de ${d.nombre}`} widths={[280, 560]}
                   sizes="(min-width: 768px) 260px, 200px" loading="eager" class="perfil-foto-img" />
          ) : (
            <div class="perfil-foto" aria-hidden="true">{d.nombre.charAt(0)}</div>
          )}
        </div>
      </div>
    </header>

    <div class="container-page cuerpo">
      <div class="prosa">
        <Content />
      </div>

      <aside class="lateral">
        {d.especialidades.length > 0 && (
          <div class="panel">
            <h2>En qué se especializa</h2>
            <ul class="lista-check">
              {d.especialidades.map((e) => <li>{e}</li>)}
            </ul>
          </div>
        )}

        <div class="panel">
          <h2>Materias</h2>
          <ul class="chips">
            {d.materias.map((m) => <li>{MATERIA_LABEL[m]}</li>)}
          </ul>
          {d.experiencia && <p class="panel-nota">{d.experiencia}</p>}
        </div>
      </aside>
    </div>

    {cursos.length > 0 && (
      <section class="section-alt">
        <div class="container-page cursos-seccion">
          <h2 class="animate-on-scroll">Cursos con {d.nombre}</h2>
          <div class="grid-cursos">
            {cursos.map((c, i) => (
              <a href={`/cursos/${c.id}/`} class:list={['curso-mini', 'animate-on-scroll', `delay-${i + 1}`]}>
                <span class="curso-mini-emoji" aria-hidden="true">{c.data.portada.emoji}</span>
                <div>
                  <h3>{c.data.titulo}</h3>
                  <p>${c.data.precio} el curso · {c.data.clasesPorSemana * 3} clases</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {otros.length > 0 && (
      <section class="container-page otros-seccion">
        <h2 class="animate-on-scroll">Los otros profes</h2>
        <div class="grid-otros">
          {otros.map((o, i) => (
            <a href={`/profesores/${o.id}/`} class:list={['otro', 'animate-on-scroll', `delay-${i + 1}`]} style={`--c:${o.data.color}`}>
              <div class="otro-foto" aria-hidden="true">{o.data.nombre.charAt(0)}</div>
              <div>
                <h3>{o.data.nombre}</h3>
                <p>{o.data.titular}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <CtaFinal
    titulo={`¿Quieres una clase con ${d.nombre}?`}
    texto="La primera es gratis y sin compromiso. Coordinamos día y hora por WhatsApp."
    mensaje={`Hola, quiero información sobre las clases con ${d.nombre}.`}
  />
</Base>

<style>
  .perfil-hero {
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--c) 14%, var(--color-surface)),
      var(--color-surface));
    padding-block: 2.5rem 3rem;
    border-bottom: 1px solid var(--color-border);
  }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }

  .miga { font-size: var(--text-sm); color: var(--color-ink-faint); margin-bottom: 0.875rem; }
  .miga a { color: var(--c); text-decoration: none; font-weight: 600; }
  .miga span { margin-inline: 0.25rem; }

  h1 { font-size: var(--text-4xl); margin: 0 0 0.25rem; }
  .titular { color: var(--c); font-weight: 700; font-family: var(--font-display); font-size: var(--text-lg); margin: 0 0 1rem; }
  .resumen { font-size: var(--text-lg); color: var(--color-ink-soft); margin: 0 0 1.5rem; max-width: 50ch; }

  .credencial {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    max-width: 34rem;
  }
  .cred-icono { font-size: 1.5rem; line-height: 1.2; }
  .cred-titulo { font-family: var(--font-display); font-weight: 800; margin: 0; }
  .cred-registro { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0.125rem 0 0; }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .nota-pronto { font-size: var(--text-sm); color: var(--color-ink-soft); margin: 1rem 0 0; max-width: 44ch; }

  .perfil-visual { display: grid; place-items: center; }
  .perfil-foto,
  .perfil-foto-img {
    width: min(13rem, 55vw);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    object-fit: cover;
    box-shadow: var(--shadow-lg);
  }
  .perfil-foto {
    background: var(--c);
    color: #fff;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 5rem;
  }

  .cuerpo {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: 3rem;
    align-items: start;
  }

  .panel {
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .panel h2 { font-size: var(--text-lg); margin: 0 0 0.875rem; }
  .panel-nota { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0.875rem 0 0; }

  .lista-check { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .lista-check li { position: relative; padding-left: 1.75rem; color: var(--color-ink-soft); font-size: var(--text-sm); }
  .lista-check li::before {
    content: '✓';
    position: absolute; left: 0; top: 0;
    width: 1.25rem; height: 1.25rem;
    display: grid; place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft); color: var(--color-accent);
    font-size: 0.6875rem; font-weight: 800;
  }

  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem; list-style: none; padding: 0; margin: 0; }
  .chips li {
    font-size: var(--text-xs);
    padding: 0.3125rem 0.75rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    color: var(--c);
    font-weight: 700;
  }

  .cursos-seccion, .otros-seccion { padding-block: 3.5rem; }
  .cursos-seccion h2, .otros-seccion h2 { font-size: var(--text-2xl); margin: 0 0 1.5rem; }

  .grid-cursos { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .curso-mini {
    display: flex; gap: 1rem; align-items: center;
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    text-decoration: none; color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .curso-mini:hover { transform: translateY(-3px); border-color: var(--c); }
  .curso-mini-emoji { font-size: 2rem; }
  .curso-mini h3 { font-size: var(--text-base); margin: 0 0 0.125rem; }
  .curso-mini p { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0; }

  .grid-otros { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .otro {
    display: flex; gap: 1rem; align-items: center;
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    text-decoration: none; color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .otro:hover { transform: translateY(-3px); border-color: var(--c); }
  .otro-foto {
    width: 3rem; height: 3rem; flex: none;
    border-radius: var(--radius-pill);
    background: var(--c); color: #fff;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 800;
  }
  .otro h3 { font-size: var(--text-base); margin: 0; }
  .otro p { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0; }

  @media (min-width: 768px) {
    .hero-grid { grid-template-columns: 1.5fr 1fr; }
    .grid-cursos, .grid-otros { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .cuerpo { grid-template-columns: 1fr 19rem; gap: 4rem; }
  }
</style>
