---
import Base from '../layouts/Base.astro';

export const prerender = false;

const destino = Astro.url.searchParams.get('destino') ?? '/estudio/';
---

<Base title="Entrar" description="Entra a tu cuenta.">
  <section class="entrar">
    <div class="caja">
      <h1>Entrar</h1>
      <p class="sub">Para profesores y estudiantes de la escuela.</p>

      <form id="form-entrar" novalidate>
        <label for="email">Correo</label>
        <input id="email" name="email" type="email" autocomplete="email" required
               placeholder="tu@correo.com" />

        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password"
               required minlength="8" placeholder="Tu contraseña" />

        <p class="error" id="error" role="alert" hidden></p>

        <button class="btn btn-primary ancho" type="submit" id="enviar">Entrar</button>
      </form>

      <p class="ayuda">
        ¿No tienes cuenta todavía? Escríbenos por WhatsApp y te la creamos.
      </p>
    </div>
  </section>
</Base>

<script define:vars={{ destino }}>
  const form = document.getElementById('form-entrar');
  const errorEl = document.getElementById('error');
  const boton = document.getElementById('enviar');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    boton.disabled = true;
    boton.textContent = 'Entrando…';

    const datos = new FormData(form);
    try {
      const res = await fetch('/api/auth/sign-in/email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: datos.get('email'),
          password: datos.get('password'),
        }),
      });

      if (res.ok) {
        window.location.href = destino;
        return;
      }

      // Deliberately vague: saying "this email does not exist" tells an attacker
      // which addresses are registered.
      errorEl.textContent = 'Correo o contraseña incorrectos.';
      errorEl.hidden = false;
    } catch {
      errorEl.textContent = 'No pudimos conectar. Revisa tu internet e intenta de nuevo.';
      errorEl.hidden = false;
    } finally {
      boton.disabled = false;
      boton.textContent = 'Entrar';
    }
  });
</script>

<style>
  .entrar {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: 3rem 1.25rem;
    background:
      radial-gradient(ellipse 70% 60% at 50% -20%, var(--color-primary-soft), transparent 70%),
      var(--color-surface);
  }
  .caja {
    width: 100%;
    max-width: 26rem;
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2.25rem;
    box-shadow: var(--shadow-md);
  }
  h1 { font-size: var(--text-3xl); margin: 0 0 0.25rem; }
  .sub { color: var(--color-ink-soft); margin: 0 0 1.75rem; }

  label {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    margin-bottom: 0.375rem;
  }
  input {
    width: 100%;
    padding: 0.8125rem 1rem;
    font-size: var(--text-base);
    font-family: inherit;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    margin-bottom: 1.125rem;
  }
  input:focus { border-color: var(--color-primary); }

  .ancho { width: 100%; }
  .error {
    background: #fdecec;
    color: var(--color-danger);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    font-size: var(--text-sm);
    margin: 0 0 1rem;
    font-weight: 600;
  }
  .ayuda { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 1.25rem 0 0; text-align: center; }
</style>
