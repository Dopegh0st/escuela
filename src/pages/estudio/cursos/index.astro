---
import Estudio from '../../../layouts/Estudio.astro';
import { getDb } from '../../../lib/db';
import { cursosDeProfesor, perfilProfesor } from '../../../lib/scope';
import { actions } from 'astro:actions';

export const prerender = false;

const actor = Astro.locals.actor!;
const db = getDb();

const perfil = await perfilProfesor(db, actor);
const cursos = await cursosDeProfesor(db, actor);

const result = Astro.getActionResult(actions.crearCurso);
if (result && !result.error) {
  return Astro.redirect(`/estudio/curso/${result.data.id}/`);
}

const MATERIA: Record<string, string> = {
  ingles: 'Inglés', musica: 'Música',
  programacion: 'Programación', 'apoyo-escolar': 'Apoyo escolar',
};
const money = (c: number) => `$${(c / 100).toFixed(2)}`;
---

<Estudio title="Mis cursos" seccion="cursos">
  <div class="cabecera">
    <div>
      <p class="sub">
        {cursos.length === 0
          ? 'Todavía no has creado ningún curso.'
          : `${cursos.length} ${cursos.length === 1 ? 'curso' : 'cursos'}`}
      </p>
    </div>
  </div>

  {!perfil && (
    <div class="aviso">
      <strong>Tu perfil de profesor todavía no está activo.</strong>
      <p>Un administrador tiene que completar tu ficha antes de que puedas crear cursos.</p>
    </div>
  )}

  {result?.error && (
    <p class="error">{result.error.message}</p>
  )}

  <div class="grid">
    {cursos.map((c) => (
      <a class="curso" href={`/estudio/curso/${c.id}/`}>
        <div class="curso-top">
          <span class={`estado estado-${c.estado}`}>
            {c.estado === 'publicado' ? 'Publicado' : c.estado === 'archivado' ? 'Archivado' : 'Borrador'}
          </span>
          <span class="materia">{MATERIA[c.materia] ?? c.materia}</span>
        </div>
        <h2>{c.titulo || 'Sin título'}</h2>
        <p class="resumen">{c.resumen || 'Sin resumen todavía.'}</p>
        <div class="curso-pie">
          <span>{money(c.precioCentavos)}</span>
          <span>·</span>
          <span>{c.clasesTotal} clases</span>
          <span>·</span>
          <span>{c.formato === 'individual' ? 'Individual' : `Grupo de ${c.cupoMax}`}</span>
        </div>
      </a>
    ))}

    {perfil && (
      <form method="POST" action={actions.crearCurso} class="nuevo">
        <h2>Crear un curso nuevo</h2>
        <label for="titulo">¿Cómo se va a llamar?</label>
        <input id="titulo" name="titulo" required minlength="3" maxlength="140"
               placeholder="Ej: Guitarra desde cero" />

        <label for="materia">¿De qué materia es?</label>
        <select id="materia" name="materia" required>
          <option value="ingles">Inglés</option>
          <option value="musica">Música</option>
          <option value="programacion">Programación</option>
          <option value="apoyo-escolar">Apoyo escolar</option>
        </select>

        <label for="formato">¿Cómo se dicta?</label>
        <select id="formato" name="formato">
          <option value="grupal">En grupo</option>
          <option value="individual">Individual</option>
        </select>

        <button class="btn btn-primary ancho" type="submit">Crear curso</button>
        <p class="nota">Se crea como borrador. Nadie lo ve hasta que tú lo publiques.</p>
      </form>
    )}
  </div>
</Estudio>

<style>
  .cabecera { margin-bottom: 1.75rem; }
  h1 { font-size: var(--text-3xl); margin: 0 0 0.25rem; }
  .sub { color: var(--color-ink-soft); margin: 0; }

  .aviso {
    background: var(--color-sun-soft);
    border: 2px solid var(--color-sun);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .aviso p { margin: 0.25rem 0 0; color: var(--color-ink-soft); }

  .error {
    background: #fdecec; color: var(--color-danger);
    border-radius: var(--radius-md); padding: 0.875rem 1.125rem;
    font-weight: 600; margin-bottom: 1.25rem;
  }

  .grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 760px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1120px) { .grid { grid-template-columns: repeat(3, 1fr); } }

  .curso {
    background: var(--color-raised);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    text-decoration: none; color: inherit;
    display: flex; flex-direction: column; gap: 0.5rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .curso:hover { transform: translateY(-3px); border-color: var(--color-primary); }
  .curso-top { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; }
  .estado {
    font-size: var(--text-xs); font-weight: 800; font-family: var(--font-display);
    padding: 0.25rem 0.625rem; border-radius: var(--radius-pill);
  }
  .estado-borrador { background: var(--color-sunken); color: var(--color-ink-faint); }
  .estado-publicado { background: var(--color-accent-soft); color: var(--color-accent); }
  .estado-archivado { background: #eee; color: #777; }
  .materia { font-size: var(--text-xs); color: var(--color-ink-faint); }
  .curso h2 { font-size: var(--text-lg); margin: 0; }
  .resumen { color: var(--color-ink-soft); font-size: var(--text-sm); margin: 0; flex: 1; }
  .curso-pie {
    display: flex; gap: 0.375rem; flex-wrap: wrap;
    font-size: var(--text-xs); color: var(--color-ink-faint);
    padding-top: 0.75rem; border-top: 1px solid var(--color-border);
  }

  .nuevo {
    background: var(--color-raised);
    border: 2px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .nuevo h2 { font-size: var(--text-lg); margin: 0 0 1rem; }
  label {
    display: block; font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-sm); margin-bottom: 0.375rem;
  }
  input, select {
    width: 100%; padding: 0.75rem 0.875rem;
    font-size: var(--text-base); font-family: inherit;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface); color: var(--color-ink);
    margin-bottom: 1rem;
  }
  input:focus, select:focus { border-color: var(--color-primary); }
  .ancho { width: 100%; }
  .nota { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0.75rem 0 0; text-align: center; }
</style>
