---
import Estudio from '../../../layouts/Estudio.astro';
import { actions } from 'astro:actions';

export const prerender = false;

const usuario = Astro.locals.usuario!;
const cambio = Astro.getActionResult(actions.cambiarClave);

/**
 * Astro raises input-validation failures as ActionInputError, whose `message`
 * is a raw JSON dump of the Zod issues. Showing that to a teacher is not an
 * error message, it is a stack trace. Pull the first human sentence out of
 * `fields` and fall back to the plain message for genuine ActionErrors.
 */
function mensajeDeError(err: unknown): string | null {
  if (!err) return null;
  const e = err as { fields?: Record<string, string[] | undefined>; message?: string };
  if (e.fields) {
    for (const msgs of Object.values(e.fields)) {
      if (msgs && msgs.length) return msgs[0];
    }
  }
  const m = e.message ?? '';
  return m.startsWith('Failed to validate')
    ? 'Revisa los datos e intenta de nuevo.'
    : m || 'No se pudo cambiar la contraseña.';
}

const errorClave = mensajeDeError(cambio?.error);
---

<Estudio title="Ajustes" seccion="ajustes">
  <div class="cols">
    <section class="panel">
      <h2>Tu cuenta</h2>
      <dl class="datos">
        <div><dt>Nombre</dt><dd>{usuario.nombre}</dd></div>
        <div><dt>Correo</dt><dd>{usuario.email}</dd></div>
        <div><dt>Permisos</dt><dd>{usuario.roles.split(',').join(' · ')}</dd></div>
      </dl>
      <p class="nota">
        Para cambiar tu nombre o tu correo, escríbenos — todavía no se edita desde aquí.
      </p>
    </section>

    <section class="panel">
      <h2>Cambiar contraseña</h2>

      {errorClave && <p class="msg malo">{errorClave}</p>}
      {cambio && !cambio.error && (
        <p class="msg bien">
          Listo, tu contraseña cambió. Cerramos las sesiones abiertas en otros dispositivos.
        </p>
      )}

      <form method="POST" action={actions.cambiarClave}>
        <label for="actual">Contraseña actual</label>
        <input id="actual" name="actual" type="password" required autocomplete="current-password" />

        <label for="nueva">Contraseña nueva</label>
        <input id="nueva" name="nueva" type="password" required minlength="8"
               autocomplete="new-password" />
        <p class="pista">Mínimo 8 caracteres.</p>

        <label for="repetir">Repite la nueva</label>
        <input id="repetir" name="repetir" type="password" required minlength="8"
               autocomplete="new-password" />

        <button class="btn btn-primary ancho" type="submit">Cambiar contraseña</button>
      </form>
    </section>
  </div>
</Estudio>

<style>
  .cols { display: grid; grid-template-columns: 1fr; gap: 1.25rem; max-width: 52rem; align-items: start; }
  @media (min-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } }

  .panel {
    background: var(--color-raised); border: 2px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 1.75rem;
  }
  .panel h2 { font-size: var(--text-lg); margin: 0 0 1.25rem; }

  .datos { margin: 0 0 1rem; display: grid; gap: 0.75rem; }
  .datos > div { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--color-border); }
  .datos > div:last-child { border-bottom: none; padding-bottom: 0; }
  .datos dt { color: var(--color-ink-faint); font-size: var(--text-sm); margin: 0; }
  .datos dd { margin: 0; font-weight: 600; font-size: var(--text-sm); text-align: right; }
  .nota { font-size: var(--text-sm); color: var(--color-ink-faint); margin: 0; }

  label { display: block; font-family: var(--font-display); font-weight: 700; font-size: var(--text-sm); margin-bottom: 0.375rem; }
  input {
    width: 100%; padding: 0.6875rem 0.875rem; font-size: var(--text-base); font-family: inherit;
    border: 2px solid var(--color-border-strong); border-radius: var(--radius-md);
    background: var(--color-surface); color: var(--color-ink); margin-bottom: 1rem;
  }
  input:focus { border-color: var(--color-primary); }
  .pista { font-size: var(--text-xs); color: var(--color-ink-faint); margin: -0.75rem 0 1rem; }
  .ancho { width: 100%; }

  .msg { border-radius: var(--radius-md); padding: 0.875rem 1.125rem; font-weight: 600; margin: 0 0 1.25rem; font-size: var(--text-sm); }
  .msg.bien { background: var(--color-accent-soft); color: var(--color-accent); }
  .msg.malo { background: #fdecec; color: var(--color-danger); }
</style>
