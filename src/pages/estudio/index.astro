---
import Estudio from '../../layouts/Estudio.astro';
import { getDb, schema } from '../../lib/db';
import { cursosDeProfesor, perfilProfesor } from '../../lib/scope';
import { eq, inArray, sql } from 'drizzle-orm';

export const prerender = false;

const actor = Astro.locals.actor!;
const usuario = Astro.locals.usuario!;
const db = getDb();

const perfil = await perfilProfesor(db, actor);
const cursos = await cursosDeProfesor(db, actor);

const cursoIds = cursos.map((c) => c.id);
const publicados = cursos.filter((c) => c.estado === 'publicado').length;
const borradores = cursos.length - publicados;

// Real counts only. A dashboard that invents numbers is worse than an empty one:
// the founder cannot tell a working feature from a decorative one.
const modulos = cursoIds.length
  ? await db.select({ id: schema.modulo.id, cursoId: schema.modulo.cursoId })
      .from(schema.modulo).where(inArray(schema.modulo.cursoId, cursoIds))
  : [];
const moduloIds = modulos.map((m) => m.id);
const lecciones = moduloIds.length
  ? await db.select({ id: schema.leccion.id })
      .from(schema.leccion).where(inArray(schema.leccion.moduloId, moduloIds))
  : [];

const matriculas = cursoIds.length
  ? await db.select({ id: schema.matricula.id })
      .from(schema.matricula).where(inArray(schema.matricula.cursoId, cursoIds))
  : [];

const solicitudes = perfil
  ? await db.select({ id: schema.claseGratis.id, nombre: schema.claseGratis.nombre,
                      estado: schema.claseGratis.estado, materia: schema.claseGratis.materia })
      .from(schema.claseGratis).where(eq(schema.claseGratis.profesorId, perfil.id))
  : [];

const proximas = perfil
  ? await db.select().from(schema.claseSesion)
      .where(eq(schema.claseSesion.profesorId, perfil.id))
      .orderBy(schema.claseSesion.inicioAt).limit(5)
  : [];

const DATOS = [
  { icono: '📚', valor: cursos.length,      etiqueta: 'Cursos',      pie: `${publicados} publicados · ${borradores} en borrador`, color: 'var(--color-primary)' },
  { icono: '🎬', valor: lecciones.length,   etiqueta: 'Lecciones',   pie: `en ${modulos.length} módulos`,                          color: 'var(--color-grape)' },
  { icono: '🎒', valor: matriculas.length,  etiqueta: 'Estudiantes', pie: 'matriculados en tus cursos',                            color: 'var(--color-accent)' },
  { icono: '🎁', valor: solicitudes.length, etiqueta: 'Clases gratis', pie: 'solicitudes recibidas',                               color: '#c98a10' },
];

const primerNombre = (usuario.nombre ?? '').split(' ')[0];
const sinCursos = cursos.length === 0;
---

<Estudio title="Inicio" seccion="inicio">
  <p class="saludo">Hola, {primerNombre} 👋</p>

  {!perfil && (
    <div class="aviso">
      <strong>Tu perfil de profesor todavía no está activo.</strong>
      <p>Un administrador tiene que completar tu ficha antes de que puedas crear cursos.</p>
    </div>
  )}

  <!-- ============ Stats ============ -->
  <div class="stats">
    {DATOS.map((d) => (
      <article class="stat" style={`--c:${d.color}`}>
        <span class="stat-icono" aria-hidden="true">{d.icono}</span>
        <p class="stat-valor">{d.valor}</p>
        <p class="stat-etiqueta">{d.etiqueta}</p>
        <p class="stat-pie">{d.pie}</p>
      </article>
    ))}
  </div>

  <div class="columnas">
    <!-- ============ Cursos ============ -->
    <section class="panel">
      <header class="panel-head">
        <h2>Tus cursos</h2>
        <a href="/estudio/cursos/" class="panel-link">Ver todos →</a>
      </header>

      {sinCursos ? (
        <div class="vacio">
          <span class="vacio-emoji" aria-hidden="true">📚</span>
          <p><strong>Todavía no has creado ningún curso.</strong></p>
          <p class="vacio-sub">Empieza por uno. Se guarda como borrador y nadie lo ve hasta que tú lo publiques.</p>
          <a class="btn btn-primary" href="/estudio/cursos/">Crear mi primer curso</a>
        </div>
      ) : (
        <ul class="lista">
          {cursos.slice(0, 5).map((c) => (
            <li>
              <a href={`/estudio/curso/${c.id}/`}>
                <span class="lista-titulo">{c.titulo}</span>
                <span class={`pill pill-${c.estado}`}>
                  {c.estado === 'publicado' ? 'Publicado' : 'Borrador'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    <!-- ============ Actividad ============ -->
    <section class="panel">
      <header class="panel-head"><h2>Qué sigue</h2></header>

      <ul class="tareas">
        <li class={cursos.length > 0 ? 'hecho' : ''}>
          <span class="check" aria-hidden="true">{cursos.length > 0 ? '✓' : '1'}</span>
          <div><strong>Crea tu primer curso</strong><span>Ponle título, materia y precio.</span></div>
        </li>
        <li class={lecciones.length > 0 ? 'hecho' : ''}>
          <span class="check" aria-hidden="true">{lecciones.length > 0 ? '✓' : '2'}</span>
          <div><strong>Agrega módulos y lecciones</strong><span>Un módulo por semana funciona bien.</span></div>
        </li>
        <li class={publicados > 0 ? 'hecho' : ''}>
          <span class="check" aria-hidden="true">{publicados > 0 ? '✓' : '3'}</span>
          <div><strong>Publica el curso</strong><span>Necesita resumen y al menos un módulo.</span></div>
        </li>
        <li class={matriculas.length > 0 ? 'hecho' : ''}>
          <span class="check" aria-hidden="true">{matriculas.length > 0 ? '✓' : '4'}</span>
          <div><strong>Recibe tu primer estudiante</strong><span>Comparte el enlace del curso por WhatsApp.</span></div>
        </li>
      </ul>
    </section>

    <!-- ============ Próximas clases ============ -->
    <section class="panel">
      <header class="panel-head"><h2>Próximas clases</h2></header>
      {proximas.length === 0 ? (
        <p class="nada">No tienes clases agendadas todavía.</p>
      ) : (
        <ul class="lista">
          {proximas.map((s) => (
            <li>
              <span class="lista-titulo">
                {new Date(s.inicioAt * 1000).toLocaleString('es-EC', {
                  weekday: 'short', day: 'numeric', month: 'short',
                  hour: '2-digit', minute: '2-digit', timeZone: 'America/Guayaquil',
                })}
              </span>
              <span class="pill">{s.estado}</span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <!-- ============ Solicitudes ============ -->
    <section class="panel">
      <header class="panel-head"><h2>Clases gratis solicitadas</h2></header>
      {solicitudes.length === 0 ? (
        <p class="nada">Nadie ha pedido una clase gratis todavía.</p>
      ) : (
        <ul class="lista">
          {solicitudes.slice(0, 5).map((s) => (
            <li>
              <span class="lista-titulo">{s.nombre}</span>
              <span class="pill">{s.estado}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</Estudio>

<style>
  .saludo { font-family: var(--font-display); font-weight: 800; font-size: var(--text-2xl); margin: 0 0 1.5rem; }

  .aviso {
    background: var(--color-sun-soft); border: 2px solid var(--color-sun);
    border-radius: var(--radius-lg); padding: 1.125rem 1.375rem; margin-bottom: 1.5rem;
  }
  .aviso p { margin: 0.25rem 0 0; color: var(--color-ink-soft); }

  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  @media (min-width: 1000px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stat {
    background: var(--color-raised); border: 2px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 1.25rem;
    border-top: 4px solid var(--c);
  }
  .stat-icono { font-size: 1.5rem; }
  .stat-valor { font-family: var(--font-display); font-weight: 800; font-size: 2.25rem; line-height: 1; margin: 0.5rem 0 0.125rem; color: var(--c); }
  .stat-etiqueta { font-family: var(--font-display); font-weight: 800; font-size: var(--text-sm); margin: 0; }
  .stat-pie { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0.125rem 0 0; }

  .columnas { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 900px) { .columnas { grid-template-columns: repeat(2, 1fr); } }

  .panel { background: var(--color-raised); border: 2px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; }
  .panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .panel h2 { font-size: var(--text-lg); margin: 0; }
  .panel-link { font-size: var(--text-sm); color: var(--color-primary); font-weight: 700; text-decoration: none; }

  .lista { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .lista li a, .lista li { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; text-decoration: none; color: inherit; }
  .lista li { padding: 0.625rem 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .lista li:hover { border-color: var(--color-primary); }
  .lista-titulo { font-size: var(--text-sm); font-weight: 600; }
  .pill { font-size: var(--text-xs); font-weight: 800; font-family: var(--font-display); padding: 0.1875rem 0.5rem; border-radius: var(--radius-pill); background: var(--color-sunken); color: var(--color-ink-faint); white-space: nowrap; }
  .pill-publicado { background: var(--color-accent-soft); color: var(--color-accent); }

  .vacio { text-align: center; padding: 1.5rem 1rem; }
  .vacio-emoji { font-size: 2.25rem; }
  .vacio p { margin: 0.5rem 0 0; }
  .vacio-sub { color: var(--color-ink-soft); font-size: var(--text-sm); margin-bottom: 1.25rem !important; }
  .nada { color: var(--color-ink-faint); font-size: var(--text-sm); margin: 0; font-style: italic; }

  .tareas { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .tareas li { display: flex; gap: 0.75rem; align-items: flex-start; }
  .tareas div { display: flex; flex-direction: column; }
  .tareas strong { font-size: var(--text-sm); }
  .tareas span:last-child { font-size: var(--text-xs); color: var(--color-ink-faint); }
  .check {
    width: 1.5rem; height: 1.5rem; flex: none;
    border-radius: var(--radius-pill);
    background: var(--color-sunken); color: var(--color-ink-faint);
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-xs);
  }
  .hecho .check { background: var(--color-accent); color: #fff; }
  .hecho strong { color: var(--color-ink-faint); text-decoration: line-through; }
</style>
