---
import Estudio from '../../../layouts/Estudio.astro';
import { getDb, schema } from '../../../lib/db';
import { cursoPropio } from '../../../lib/scope';
import { actions } from 'astro:actions';
import { eq, inArray } from 'drizzle-orm';

export const prerender = false;

const { id } = Astro.params;
const actor = Astro.locals.actor!;
const db = getDb();

const curso = await cursoPropio(db, actor, id!);
// 404 rather than 403: a 403 would confirm the course exists.
if (!curso) return new Response('No encontramos ese curso.', { status: 404 });

const guardado = Astro.getActionResult(actions.guardarCurso);
const publicado = Astro.getActionResult(actions.publicarCurso);
const cursoActual = (guardado && !guardado.error) || (publicado && !publicado.error)
  ? (await cursoPropio(db, actor, id!))!
  : curso;

const modulos = await db.select().from(schema.modulo)
  .where(eq(schema.modulo.cursoId, id!)).orderBy(schema.modulo.orden);

const modIds = modulos.map((m) => m.id);
const lecciones = modIds.length
  ? await db.select().from(schema.leccion)
      .where(inArray(schema.leccion.moduloId, modIds))
      .orderBy(schema.leccion.orden)
  : [];

const leccionesPorModulo = new Map<string, typeof lecciones>();
for (const m of modulos) leccionesPorModulo.set(m.id, []);
for (const l of lecciones) leccionesPorModulo.get(l.moduloId)?.push(l);

const totalLecciones = lecciones.length;
const estaPublicado = cursoActual.estado === 'publicado';
---

<Estudio title={cursoActual.titulo} seccion="cursos" volverA="/estudio/cursos/" volverTexto="Mis cursos">
  <div class="top">
    <div>
      <span class={`estado estado-${cursoActual.estado}`}>
        {estaPublicado ? 'Publicado' : 'Borrador'}
      </span>
      <h1>{cursoActual.titulo}</h1>
      <p class="sub">{modulos.length} módulos · {totalLecciones} lecciones</p>
    </div>

    <div class="top-acciones">
      {estaPublicado && (
        <a class="btn btn-secondary" href={`/cursos/${cursoActual.slug}/`} target="_blank" rel="noopener">
          Ver como estudiante ↗
        </a>
      )}
      <form method="POST" action={actions.publicarCurso}>
        <input type="hidden" name="cursoId" value={cursoActual.id} />
        <input type="hidden" name="publicar" value={estaPublicado ? 'false' : 'true'} />
        <button class={estaPublicado ? 'btn btn-secondary' : 'btn btn-primary'} type="submit">
          {estaPublicado ? 'Pasar a borrador' : 'Publicar curso'}
        </button>
      </form>
    </div>
  </div>

  {publicado?.error && <p class="error">{publicado.error.message}</p>}
  {guardado?.error && <p class="error">{guardado.error.message}</p>}
  {guardado && !guardado.error && <p class="ok">Guardado.</p>}
  {publicado && !publicado.error && <p class="ok">Listo, el curso quedó como {publicado.data.estado}.</p>}

  <div class="columnas">
    <!-- ============ Contenido ============ -->
    <section class="panel">
      <h2>Contenido del curso</h2>
      <p class="panel-sub">
        Los módulos agrupan las lecciones. Usa las flechas para cambiarlas de orden.
      </p>

      <div id="modulos">
        {modulos.map((m, mi) => (
          <article class="modulo" data-modulo={m.id}>
            <header class="modulo-head">
              <span class="modulo-num">{mi + 1}</span>
              <h3>{m.titulo}</h3>
              <div class="orden-btns">
                <button type="button" class="mini" data-mover="mod-arriba" aria-label="Subir módulo">↑</button>
                <button type="button" class="mini" data-mover="mod-abajo" aria-label="Bajar módulo">↓</button>
              </div>
              <form method="POST" action={actions.borrarModulo}
                    onsubmit="return confirm('¿Borrar este módulo y todas sus lecciones? No se puede deshacer.')">
                <input type="hidden" name="moduloId" value={m.id} />
                <button class="mini mini-borrar" type="submit" aria-label="Borrar módulo">✕</button>
              </form>
            </header>

            <ul class="lecciones">
              {(leccionesPorModulo.get(m.id) ?? []).map((l) => (
                <li data-leccion={l.id}>
                  <span class="lec-titulo">{l.titulo}</span>
                  <div class="orden-btns">
                    <button type="button" class="mini" data-mover="lec-arriba" aria-label="Subir lección">↑</button>
                    <button type="button" class="mini" data-mover="lec-abajo" aria-label="Bajar lección">↓</button>
                  </div>
                  <form method="POST" action={actions.borrarLeccion}
                        onsubmit="return confirm('¿Borrar esta lección?')">
                    <input type="hidden" name="leccionId" value={l.id} />
                    <button class="mini mini-borrar" type="submit" aria-label="Borrar lección">✕</button>
                  </form>
                </li>
              ))}
              {(leccionesPorModulo.get(m.id) ?? []).length === 0 && (
                <li class="vacia">Todavía no hay lecciones en este módulo.</li>
              )}
            </ul>

            <form method="POST" action={actions.crearLeccion} class="agregar">
              <input type="hidden" name="moduloId" value={m.id} />
              <input name="titulo" required minlength="2" maxlength="140"
                     placeholder="Título de la lección" />
              <button class="btn btn-secondary chico" type="submit">+ Lección</button>
            </form>
          </article>
        ))}
      </div>

      {modulos.length === 0 && (
        <div class="vacio">
          <p><strong>Este curso todavía está vacío.</strong></p>
          <p>Empieza creando el primer módulo — por ejemplo “Semana 1”.</p>
        </div>
      )}

      <form method="POST" action={actions.crearModulo} class="agregar agregar-modulo">
        <input type="hidden" name="cursoId" value={cursoActual.id} />
        <input name="titulo" required minlength="2" maxlength="120"
               placeholder="Nombre del módulo (ej: Semana 1)" />
        <button class="btn btn-primary chico" type="submit">+ Módulo</button>
      </form>

      <p id="orden-estado" class="orden-estado" hidden>Guardando orden…</p>
    </section>

    <!-- ============ Ajustes ============ -->
    <section class="panel">
      <h2>Ajustes</h2>
      <form method="POST" action={actions.guardarCurso}>
        <input type="hidden" name="cursoId" value={cursoActual.id} />

        <label for="titulo">Título</label>
        <input id="titulo" name="titulo" required maxlength="140" value={cursoActual.titulo} />

        <label for="resumen">Resumen <span class="hint">— aparece en la tarjeta del curso, máx. 180</span></label>
        <textarea id="resumen" name="resumen" rows="3" maxlength="180"
                  placeholder="Una o dos frases, como se lo contarías a alguien.">{cursoActual.resumen}</textarea>

        <label for="descripcion">Descripción larga</label>
        <textarea id="descripcion" name="descripcion" rows="7"
                  placeholder="De qué se trata, qué van a lograr, qué necesitan.">{cursoActual.descripcion ?? ''}</textarea>

        <div class="fila">
          <div>
            <label for="nivel">Nivel</label>
            <select id="nivel" name="nivel">
              {['principiante', 'intermedio', 'avanzado', 'todos'].map((n) => (
                <option value={n} selected={cursoActual.nivel === n}>
                  {n === 'principiante' ? 'Desde cero' : n === 'todos' ? 'Todos los niveles' : n}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label for="formato">Formato</label>
            <select id="formato" name="formato">
              <option value="grupal" selected={cursoActual.formato === 'grupal'}>En grupo</option>
              <option value="individual" selected={cursoActual.formato === 'individual'}>Individual</option>
            </select>
          </div>
        </div>

        <div class="fila">
          <div>
            <label for="clasesTotal">Clases en total</label>
            <input id="clasesTotal" name="clasesTotal" type="number" min="1" max="60" value={cursoActual.clasesTotal} />
          </div>
          <div>
            <label for="clasesPorSemana">Por semana</label>
            <input id="clasesPorSemana" name="clasesPorSemana" type="number" min="1" max="7" value={cursoActual.clasesPorSemana} />
          </div>
        </div>

        <div class="fila">
          <div>
            <label for="duracionMin">Minutos por clase</label>
            <input id="duracionMin" name="duracionMin" type="number" min="15" max="180" value={cursoActual.duracionMin} />
          </div>
          <div>
            <label for="cupoMax">Cupo máximo</label>
            <input id="cupoMax" name="cupoMax" type="number" min="1" max="40" value={cursoActual.cupoMax} />
          </div>
        </div>

        <label for="precio">Precio del curso completo (USD)</label>
        <input id="precio" name="precio" type="number" step="0.01" min="0" max="2000"
               value={(cursoActual.precioCentavos / 100).toFixed(2)} />
        <p class="hint hint-bloque">
          Referencia del mercado: $25 en grupo, $60 individual, por 6 clases.
        </p>

        <button class="btn btn-primary ancho" type="submit">Guardar cambios</button>
      </form>
    </section>
  </div>
</Estudio>

<script>
  import { actions } from 'astro:actions';

  const cont = document.getElementById('modulos');
  const estado = document.getElementById('orden-estado');
  const cursoId = new URL(location.href).pathname.split('/').filter(Boolean)[2];

  function leerOrden() {
    return [...document.querySelectorAll('[data-modulo]')].map((mod, mi) => ({
      id: (mod as HTMLElement).dataset.modulo!,
      orden: mi,
      lecciones: [...mod.querySelectorAll('[data-leccion]')].map((lec, li) => ({
        id: (lec as HTMLElement).dataset.leccion!,
        orden: li,
      })),
    }));
  }

  let guardando: ReturnType<typeof setTimeout> | undefined;
  async function persistir() {
    clearTimeout(guardando);
    // Debounced: someone clicking ↑ four times fast should write once.
    guardando = setTimeout(async () => {
      estado!.hidden = false;
      estado!.textContent = 'Guardando orden…';
      const { error } = await actions.reordenar({ cursoId, modulos: leerOrden() });
      estado!.textContent = error ? 'No se pudo guardar el orden.' : 'Orden guardado.';
      setTimeout(() => { estado!.hidden = true; }, 1800);
    }, 400);
  }

  cont?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-mover]') as HTMLElement | null;
    if (!btn) return;
    const accion = btn.dataset.mover!;

    if (accion.startsWith('mod-')) {
      const mod = btn.closest('[data-modulo]')!;
      const hermano = accion === 'mod-arriba'
        ? mod.previousElementSibling : mod.nextElementSibling;
      if (!hermano) return;
      accion === 'mod-arriba'
        ? mod.parentElement!.insertBefore(mod, hermano)
        : mod.parentElement!.insertBefore(hermano, mod);
    } else {
      const lec = btn.closest('[data-leccion]')!;
      const hermano = accion === 'lec-arriba'
        ? lec.previousElementSibling : lec.nextElementSibling;
      if (!hermano || !(hermano as HTMLElement).dataset.leccion) return;
      accion === 'lec-arriba'
        ? lec.parentElement!.insertBefore(lec, hermano)
        : lec.parentElement!.insertBefore(hermano, lec);
    }

    // Renumber the visible module badges so the UI never lies about order.
    document.querySelectorAll('[data-modulo] .modulo-num')
      .forEach((el, i) => { el.textContent = String(i + 1); });

    persistir();
  });
</script>

<style>
  .top { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
  h1 { font-size: var(--text-2xl); margin: 0.375rem 0 0.25rem; }
  .sub { color: var(--color-ink-soft); margin: 0; font-size: var(--text-sm); }
  .top-acciones { display: flex; gap: 0.625rem; flex-wrap: wrap; }
  .estado { font-size: var(--text-xs); font-weight: 800; font-family: var(--font-display); padding: 0.25rem 0.625rem; border-radius: var(--radius-pill); }
  .estado-borrador { background: var(--color-sunken); color: var(--color-ink-faint); }
  .estado-publicado { background: var(--color-accent-soft); color: var(--color-accent); }

  .error { background: #fdecec; color: var(--color-danger); border-radius: var(--radius-md); padding: 0.875rem 1.125rem; font-weight: 600; margin-bottom: 1rem; }
  .ok { background: var(--color-accent-soft); color: var(--color-accent); border-radius: var(--radius-md); padding: 0.875rem 1.125rem; font-weight: 600; margin-bottom: 1rem; }

  .columnas { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: start; }
  @media (min-width: 1000px) { .columnas { grid-template-columns: 1.25fr 1fr; } }

  .panel { background: var(--color-raised); border: 2px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.75rem; }
  .panel h2 { font-size: var(--text-xl); margin: 0 0 0.25rem; }
  .panel-sub { color: var(--color-ink-soft); font-size: var(--text-sm); margin: 0 0 1.5rem; }

  .modulo { border: 2px solid var(--color-border); border-radius: var(--radius-md); margin-bottom: 1rem; overflow: hidden; }
  .modulo-head { display: flex; align-items: center; gap: 0.625rem; padding: 0.875rem 1rem; background: var(--color-sunken); }
  .modulo-num { width: 1.75rem; height: 1.75rem; flex: none; border-radius: var(--radius-pill); background: var(--color-primary); color: #fff; display: grid; place-items: center; font-family: var(--font-display); font-weight: 800; font-size: var(--text-xs); }
  .modulo-head h3 { font-size: var(--text-base); margin: 0; flex: 1; }
  .orden-btns { display: flex; gap: 0.25rem; }
  .mini { width: 1.75rem; height: 1.75rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border-strong); background: var(--color-raised); cursor: pointer; font-size: var(--text-xs); color: var(--color-ink-soft); display: grid; place-items: center; }
  .mini:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .mini-borrar:hover { border-color: var(--color-danger); color: var(--color-danger); }

  .lecciones { list-style: none; margin: 0; padding: 0; }
  .lecciones li { display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 1rem; border-top: 1px solid var(--color-border); }
  .lec-titulo { flex: 1; font-size: var(--text-sm); }
  .vacia { color: var(--color-ink-faint); font-size: var(--text-sm); font-style: italic; }

  .agregar { display: flex; gap: 0.5rem; padding: 0.75rem 1rem; border-top: 1px solid var(--color-border); background: var(--color-surface); }
  .agregar input { flex: 1; margin: 0; padding: 0.5rem 0.75rem; font-size: var(--text-sm); border: 2px solid var(--color-border-strong); border-radius: var(--radius-sm); background: var(--color-raised); }
  .agregar-modulo { border: 2px dashed var(--color-border-strong); border-radius: var(--radius-md); margin-top: 1rem; }
  .chico { min-height: 38px; padding: 0.5rem 1rem; font-size: var(--text-sm); }

  .vacio { text-align: center; padding: 2rem 1rem; color: var(--color-ink-soft); border: 2px dashed var(--color-border-strong); border-radius: var(--radius-md); }
  .vacio p { margin: 0 0 0.25rem; }

  .orden-estado { font-size: var(--text-sm); color: var(--color-accent); font-weight: 600; margin: 0.875rem 0 0; }

  label { display: block; font-family: var(--font-display); font-weight: 700; font-size: var(--text-sm); margin-bottom: 0.375rem; }
  .hint { font-weight: 500; color: var(--color-ink-faint); font-size: var(--text-xs); }
  .hint-bloque { margin: -0.5rem 0 1rem; }
  input, select, textarea { width: 100%; padding: 0.6875rem 0.875rem; font-size: var(--text-base); font-family: inherit; border: 2px solid var(--color-border-strong); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-ink); margin-bottom: 1rem; }
  textarea { resize: vertical; line-height: 1.5; }
  input:focus, select:focus, textarea:focus { border-color: var(--color-primary); }
  .fila { display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem; }
  .ancho { width: 100%; }
</style>
