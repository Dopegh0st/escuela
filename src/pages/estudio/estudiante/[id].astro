---
import Estudio from '../../../layouts/Estudio.astro';
import { getDb } from '../../../lib/db';
import { detalleEstudiante } from '../../../lib/estudiantes';
import { asistenciaDeEstudiante, diaCorto, horaDe } from '../../../lib/agenda';
import { fechaCorta } from '../../../lib/progreso';
import { actions } from 'astro:actions';

export const prerender = false;

const { id } = Astro.params;
const actor = Astro.locals.actor!;
const db = getDb();
const ahora = Math.floor(Date.now() / 1000);

// Null for anyone not enrolled with this teacher. 404, never 403.
const datos = await detalleEstudiante(db, actor, id!);
if (!datos) return new Response('No encontramos a ese estudiante.', { status: 404 });

const { usuario, cursos, cursoIds } = datos;
const asistencia = await asistenciaDeEstudiante(db, usuario.id, cursoIds);
const marcadas = asistencia.filter((a) => a.asistio !== null);
const presentes = marcadas.filter((a) => a.asistio === true).length;

const revocado = Astro.getActionResult(actions.revocarMatricula);

const edad = usuario.fechaNacimiento
  ? Math.floor((ahora - usuario.fechaNacimiento) / (365.25 * 86400))
  : null;

const totalLecciones = cursos.reduce((n, c) => n + c.total, 0);
const totalHechas = cursos.reduce((n, c) => n + c.completas, 0);
const pctGeneral = totalLecciones ? Math.round((totalHechas / totalLecciones) * 100) : 0;

const inicial = usuario.name.charAt(0).toUpperCase();
---

<Estudio
  title={usuario.name}
  seccion="estudiantes"
  volverA="/estudio/estudiantes/"
  volverTexto="Estudiantes"
>
  {revocado && !revocado.error && <p class="msg bien">Cupo retirado. El historial se conserva.</p>}

  <header class="ficha">
    <span class="avatar" aria-hidden="true">{inicial}</span>
    <div class="ficha-datos">
      <h1>{usuario.name}</h1>
      <p class="contacto">
        <a href={`mailto:${usuario.email}`}>{usuario.email}</a>
        {usuario.telefono && <><span class="sep">·</span><span>{usuario.telefono}</span></>}
      </p>
      <p class="meta">
        {edad !== null && (
          <span class:list={['etiqueta', edad < 18 && 'menor']}>
            {edad} años{edad < 18 ? ' · menor de edad' : ''}
          </span>
        )}
        <span>Con la escuela desde {fechaCorta(Math.floor(usuario.createdAt.getTime() / 1000))}</span>
      </p>
    </div>
    <div class="resumen-num">
      <p class="grande">{pctGeneral}%</p>
      <p class="grande-pie">{totalHechas} de {totalLecciones} lecciones</p>
      {marcadas.length > 0 && (
        <p class="grande-pie">{presentes} de {marcadas.length} clases asistidas</p>
      )}
    </div>
  </header>

  <div class="cols">
    <!-- ==================== Progress per course ==================== -->
    <section>
      <h2 class="titulo-seccion">Avance por curso</h2>

      {cursos.map((c) => (
        <article class="curso">
          <header class="curso-head">
            <div>
              <h3>{c.curso.titulo}</h3>
              <p class="curso-meta">
                {c.total === 0
                  ? 'Todavía no tiene lecciones publicadas'
                  : `${c.completas} de ${c.total} lecciones · ${c.pct}%`}
                {c.matricula.origen !== 'compra' && (
                  <span class="origen">
                    {c.matricula.origen === 'prueba_gratis' ? 'clase de prueba' : 'cortesía'}
                  </span>
                )}
              </p>
            </div>
            <form method="POST" action={actions.revocarMatricula}
                  onsubmit="return confirm('¿Retirar el cupo de este curso? El estudiante deja de ver el contenido. Su avance se conserva.')">
              <input type="hidden" name="matriculaId" value={c.matricula.id} />
              <button class="texto-btn" type="submit">Retirar cupo</button>
            </form>
          </header>

          {c.total > 0 && (
            <div class="barra-grande"><span style={`width:${c.pct}%`}></span></div>
          )}

          {c.modulos.length === 0 ? (
            <p class="nada">Este curso todavía no tiene lecciones publicadas.</p>
          ) : (
            c.modulos.map((m) => (
              <div class="modulo">
                <p class="modulo-titulo">
                  {m.modulo.titulo}
                  <span class="modulo-cuenta">
                    {m.lecciones.filter((l) => l.hecha).length}/{m.lecciones.length}
                  </span>
                </p>
                <ul class="lecciones">
                  {m.lecciones.map((l) => (
                    <li class:list={['leccion', l.hecha && 'hecha']}>
                      <span class="check" aria-hidden="true">{l.hecha ? '✓' : ''}</span>
                      <span class="lec-titulo">{l.leccion.titulo}</span>
                      {l.enAt && <span class="lec-fecha">{fechaCorta(l.enAt)}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          )}
        </article>
      ))}
    </section>

    <!-- ==================== Attendance ==================== -->
    <section>
      <h2 class="titulo-seccion">Asistencia</h2>

      {asistencia.length === 0 ? (
        <div class="panel">
          <p class="nada">
            No hay clases en vivo registradas en sus cursos. Agenda una desde
            <a href="/estudio/agenda/"> la Agenda</a>.
          </p>
        </div>
      ) : (
        <div class="panel">
          <ul class="asistencia">
            {asistencia.slice(0, 25).map((a) => (
              <li class:list={['clase', a.sesion.estado === 'cancelada' && 'anulada']}>
                <span class:list={[
                  'punto',
                  a.sesion.estado === 'cancelada' ? 'gris'
                    : a.asistio === true ? 'si'
                    : a.asistio === false ? 'no' : 'pendiente',
                ]} aria-hidden="true"></span>
                <span class="clase-fecha">{diaCorto(a.sesion.inicioAt)}</span>
                <span class="clase-hora">{horaDe(a.sesion.inicioAt)}</span>
                <span class="clase-estado">
                  {a.sesion.estado === 'cancelada' ? 'Cancelada'
                    : a.asistio === true ? 'Asistió'
                    : a.asistio === false ? 'Faltó'
                    : a.sesion.inicioAt > ahora ? 'Próxima' : 'Sin registrar'}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </div>
</Estudio>

<style>
  .msg { border-radius: var(--radius-md); padding: 0.875rem 1.125rem; font-weight: 600; margin: 0 0 1.25rem; font-size: var(--text-sm); }
  .msg.bien { background: var(--color-accent-soft); color: var(--color-accent); }

  .ficha {
    display: flex; align-items: flex-start; gap: 1rem; flex-wrap: wrap;
    background: var(--color-raised); border: 2px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 1.75rem;
  }
  .avatar {
    width: 3.25rem; height: 3.25rem; flex: none; border-radius: var(--radius-pill);
    background: var(--color-primary); color: #fff; display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-xl);
  }
  .ficha-datos { flex: 1; min-width: 14rem; }
  .ficha h1 { font-size: var(--text-xl); margin: 0 0 0.25rem; }
  .contacto { font-size: var(--text-sm); margin: 0 0 0.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .contacto a { color: var(--color-primary); }
  .sep { color: var(--color-ink-faint); }
  .meta { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0; display: flex; gap: 0.625rem; flex-wrap: wrap; align-items: center; }
  .etiqueta {
    font-weight: 800; font-family: var(--font-display);
    padding: 0.1875rem 0.5rem; border-radius: var(--radius-pill);
    background: var(--color-sunken); color: var(--color-ink-soft);
  }
  /* Age is flagged because who is a minor changes what the school owes them. */
  .etiqueta.menor { background: var(--color-sun-soft); color: #7a5200; }

  .resumen-num { text-align: right; margin-left: auto; }
  .grande { font-family: var(--font-display); font-weight: 800; font-size: 2rem; line-height: 1; margin: 0; color: var(--color-accent); }
  .grande-pie { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0.25rem 0 0; }

  .cols { display: grid; grid-template-columns: 1fr; gap: 1.75rem; align-items: start; }
  @media (min-width: 1000px) { .cols { grid-template-columns: 1fr 20rem; } }

  .titulo-seccion { font-size: var(--text-lg); margin: 0 0 1rem; }
  .panel { background: var(--color-raised); border: 2px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.25rem; }
  .nada { color: var(--color-ink-faint); font-size: var(--text-sm); margin: 0; line-height: 1.6; }
  .nada a { color: var(--color-primary); }

  .curso {
    background: var(--color-raised); border: 2px solid var(--color-border);
    border-radius: var(--radius-lg); padding: 1.25rem 1.5rem; margin-bottom: 1rem;
  }
  .curso-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 0.875rem; }
  .curso h3 { font-size: var(--text-base); margin: 0 0 0.125rem; }
  .curso-meta { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .origen {
    font-weight: 800; font-family: var(--font-display);
    padding: 0.125rem 0.4375rem; border-radius: var(--radius-pill);
    background: var(--color-primary-soft); color: var(--color-primary);
  }

  .barra-grande { height: 8px; border-radius: var(--radius-pill); background: var(--color-sunken); overflow: hidden; margin-bottom: 1.25rem; }
  .barra-grande span { display: block; height: 100%; background: var(--color-accent); border-radius: var(--radius-pill); }

  .modulo { margin-bottom: 1rem; }
  .modulo:last-child { margin-bottom: 0; }
  .modulo-titulo {
    font-family: var(--font-display); font-weight: 800; font-size: var(--text-sm);
    margin: 0 0 0.375rem; display: flex; justify-content: space-between; gap: 1rem;
  }
  .modulo-cuenta { color: var(--color-ink-faint); font-size: var(--text-xs); font-variant-numeric: tabular-nums; }

  .lecciones { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.25rem; }
  .leccion { display: flex; align-items: center; gap: 0.625rem; padding: 0.375rem 0; }
  .check {
    width: 1.125rem; height: 1.125rem; flex: none; border-radius: var(--radius-pill);
    border: 2px solid var(--color-border-strong); display: grid; place-items: center;
    font-size: 0.625rem; font-weight: 800; color: transparent;
  }
  .hecha .check { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .lec-titulo { flex: 1; font-size: var(--text-sm); min-width: 0; }
  .hecha .lec-titulo { color: var(--color-ink-faint); }
  .lec-fecha { font-size: var(--text-xs); color: var(--color-ink-faint); white-space: nowrap; font-variant-numeric: tabular-nums; }

  .asistencia { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.125rem; }
  .clase {
    display: grid; grid-template-columns: auto 1fr auto; gap: 0.5rem 0.625rem;
    align-items: center; padding: 0.5rem 0; border-bottom: 1px solid var(--color-border);
  }
  .clase:last-child { border-bottom: none; }
  .clase.anulada { opacity: 0.55; }
  /* State is a dot AND a word, so it never depends on colour alone. */
  .punto { width: 0.5rem; height: 0.5rem; border-radius: var(--radius-pill); }
  .punto.si { background: var(--color-accent); }
  .punto.no { background: var(--color-danger); }
  .punto.pendiente { background: var(--color-border-strong); }
  .punto.gris { background: var(--color-ink-faint); }
  .clase-fecha { font-size: var(--text-sm); font-weight: 600; }
  .clase-fecha::first-letter { text-transform: uppercase; }
  .clase-hora { font-size: var(--text-xs); color: var(--color-ink-faint); grid-column: 2; }
  .clase-estado { font-size: var(--text-xs); font-weight: 700; color: var(--color-ink-soft); grid-row: 1 / 3; grid-column: 3; white-space: nowrap; }

  .texto-btn {
    background: none; border: none; cursor: pointer; padding: 0;
    color: var(--color-ink-faint); font-size: var(--text-xs);
    font-weight: 700; font-family: var(--font-display); white-space: nowrap;
  }
  .texto-btn:hover { color: var(--color-danger); }
</style>
