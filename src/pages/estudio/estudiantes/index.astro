---
import Estudio from '../../../layouts/Estudio.astro';

export const prerender = false;
---

<Estudio title="Estudiantes" seccion="estudiantes">
  <div class="pendiente">
    <span class="emoji" aria-hidden="true">🎒</span>
    <h2>Estudiantes</h2>
    <p>Aquí vas a ver quién está matriculado en tus cursos, su progreso y su asistencia. Se activa cuando entre el primer estudiante.</p>
    <a class="btn btn-secondary" href="/estudio/">Volver al inicio</a>
  </div>
</Estudio>

<style>
  .pendiente {
    background: var(--color-raised);
    border: 2px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: 3.5rem 1.5rem;
    text-align: center;
    max-width: 34rem;
  }
  .emoji { font-size: 2.5rem; }
  h2 { font-size: var(--text-xl); margin: 0.75rem 0 0.375rem; }
  p { color: var(--color-ink-soft); margin: 0 auto 1.5rem; max-width: 42ch; }
</style>
