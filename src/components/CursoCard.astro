---
import type { CollectionEntry } from 'astro:content';

interface Props {
  curso: CollectionEntry<'cursos'>;
}

const { curso } = Astro.props;
const d = curso.data;

const MATERIA_LABEL: Record<string, string> = {
  ingles: 'Inglés',
  musica: 'Música',
  programacion: 'Programación',
  'apoyo-escolar': 'Apoyo escolar',
};

const NIVEL_LABEL: Record<string, string> = {
  principiante: 'Desde cero',
  intermedio: 'Nivel intermedio',
  avanzado: 'Nivel avanzado',
  todos: 'Todos los niveles',
};

const formato =
  d.formato === 'individual'
    ? 'Clase individual'
    : `Grupo de ${d.cupoMin}–${d.cupoMax}`;

const frecuencia = `${d.clasesPorSemana}× por semana · ${d.duracionMin} min`;
---

<article class="curso-card">
  <a href={`/cursos/${curso.id}/`} class="curso-portada"
     style={`--desde:${d.portada.desde}; --hasta:${d.portada.hasta}`}
     aria-hidden="true" tabindex="-1">
    <span class="curso-emoji">{d.portada.emoji}</span>
    <span class="curso-materia">{MATERIA_LABEL[d.materia]}</span>
  </a>

  <div class="curso-cuerpo">
    <div class="curso-autor">
      <span class="curso-avatar">{d.profesor.charAt(0)}</span>
      <span class="curso-autor-nombre">{d.profesor}</span>
      <span class="curso-sep">·</span>
      <span class="curso-nivel">{NIVEL_LABEL[d.nivel]}</span>
    </div>

    <h3 class="curso-titulo">
      <a href={`/cursos/${curso.id}/`}>{d.titulo}</a>
    </h3>

    <p class="curso-resumen">{d.resumen}</p>

    <div class="curso-chips">
      <span class="chip">{formato}</span>
      <span class="chip">{frecuencia}</span>
    </div>

    <div class="curso-pie">
      <p class="curso-precio">
        <span class="curso-sim">$</span>{d.precio}
        <span class="curso-unidad">/ {d.precioUnidad}</span>
      </p>
      <a class="curso-link" href={`/cursos/${curso.id}/`}>
        Ver el curso <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .curso-card {
    background: var(--color-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .curso-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-border-strong);
  }

  /* A designed typographic cover, not stock photography. Honest about having
     no photos yet, loads in zero bytes, and looks deliberate. */
  .curso-portada {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--desde), var(--hasta));
    text-decoration: none;
  }
  .curso-emoji { font-size: 3.25rem; line-height: 1; filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.25)); }
  .curso-materia {
    position: absolute;
    left: 0.875rem;
    bottom: 0.875rem;
    background: rgb(255 255 255 / 0.92);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xs);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
  }

  .curso-cuerpo {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
  }

  .curso-autor {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }
  .curso-avatar {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-sm);
  }
  .curso-autor-nombre { font-weight: 600; color: var(--color-ink); }
  .curso-sep { color: var(--color-ink-faint); }

  .curso-titulo { font-size: var(--text-lg); margin: 0; line-height: 1.3; }
  .curso-titulo a { color: var(--color-ink); text-decoration: none; }
  .curso-titulo a:hover { color: var(--color-primary); }

  .curso-resumen { color: var(--color-ink-soft); margin: 0; font-size: var(--text-sm); flex: 1; }

  .curso-chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .chip {
    font-size: var(--text-xs);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    background: var(--color-sunken);
    color: var(--color-ink-soft);
    border: 1px solid var(--color-border);
  }

  .curso-pie {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-border);
    margin-top: 0.25rem;
  }
  .curso-precio {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-2xl);
    margin: 0;
    letter-spacing: -0.03em;
  }
  .curso-sim { font-size: var(--text-base); vertical-align: super; }
  .curso-unidad { font-size: var(--text-sm); font-weight: 500; color: var(--color-ink-faint); letter-spacing: 0; }
  .curso-link { color: var(--color-primary); font-weight: 600; font-size: var(--text-sm); text-decoration: none; white-space: nowrap; }
  .curso-link:hover { text-decoration: underline; }
</style>
