---
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title: string;
  seccion?: 'inicio' | 'cursos' | 'blog' | 'avisos' | 'estudiantes' | 'agenda' | 'ajustes';
  volverA?: string;
  volverTexto?: string;
}

const { title, seccion = 'inicio', volverA, volverTexto } = Astro.props;
const usuario = Astro.locals.usuario;
const inicial = (usuario?.nombre ?? '?').charAt(0).toUpperCase();

const MENU_PRINCIPAL = [
  { id: 'inicio',      href: '/estudio/',             icono: '🏠', texto: 'Inicio' },
  { id: 'cursos',      href: '/estudio/cursos/',      icono: '📚', texto: 'Mis cursos' },
  { id: 'blog',        href: '/estudio/blog/',        icono: '✍️', texto: 'Blog' },
  { id: 'avisos',      href: '/estudio/avisos/',      icono: '🔔', texto: 'Avisos' },
  { id: 'estudiantes', href: '/estudio/estudiantes/', icono: '🎒', texto: 'Estudiantes' },
  { id: 'agenda',      href: '/estudio/agenda/',      icono: '🗓️', texto: 'Agenda' },
];
const MENU_OTROS = [
  { id: 'ajustes', href: '/estudio/ajustes/', icono: '⚙️', texto: 'Ajustes' },
];
---

<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Estudio · {SITE.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&display=swap" />
  </head>

  <body>
    <div class="shell">
      <!-- ===================== SIDEBAR ===================== -->
      <aside class="lateral" id="lateral">
        <a href="/estudio/" class="marca">
          <span class="marca-icono" aria-hidden="true">◆</span>
          <span class="marca-texto">{SITE.name}</span>
        </a>

        <nav aria-label="Menú principal">
          <p class="grupo">Principal</p>
          <ul>
            {MENU_PRINCIPAL.map((m) => (
              <li>
                <a href={m.href} class:list={['item', seccion === m.id && 'activo']}
                   aria-current={seccion === m.id ? 'page' : undefined}>
                  <span class="item-icono" aria-hidden="true">{m.icono}</span>
                  <span>{m.texto}</span>
                </a>
              </li>
            ))}
          </ul>

          <p class="grupo">Otros</p>
          <ul>
            {MENU_OTROS.map((m) => (
              <li>
                <a href={m.href} class:list={['item', seccion === m.id && 'activo']}
                   aria-current={seccion === m.id ? 'page' : undefined}>
                  <span class="item-icono" aria-hidden="true">{m.icono}</span>
                  <span>{m.texto}</span>
                </a>
              </li>
            ))}
            <li>
              <a href="/" class="item" target="_blank" rel="noopener">
                <span class="item-icono" aria-hidden="true">🌐</span>
                <span>Ver el sitio</span>
              </a>
            </li>
          </ul>
        </nav>
      </aside>

      <div class="velo" id="velo" hidden></div>

      <!-- ===================== CONTENT ===================== -->
      <div class="principal">
        <header class="barra">
          <button class="menu-btn" id="menu-btn" type="button" aria-label="Abrir menú" aria-expanded="false">
            <span aria-hidden="true">☰</span>
          </button>

          <div class="barra-titulo">
            {volverA && <a class="volver" href={volverA}>← {volverTexto ?? 'Volver'}</a>}
            <h1>{title}</h1>
          </div>

          <div class="barra-usuario">
            <div class="usuario-info">
              <p class="usuario-nombre">{usuario?.nombre ?? 'Invitado'}</p>
              <p class="usuario-rol">
                {usuario?.roles?.includes('admin') ? 'Administrador' : 'Profesor'}
              </p>
            </div>
            <span class="avatar" aria-hidden="true">{inicial}</span>
            <button class="salir" id="salir" type="button" title="Cerrar sesión">Salir</button>
          </div>
        </header>

        <main class="contenido">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      document.getElementById('salir')?.addEventListener('click', async () => {
        await fetch('/api/auth/sign-out', { method: 'POST' });
        window.location.href = '/entrar';
      });

      // Sidebar is off-canvas below 900px. Teachers may well be on a phone.
      const lateral = document.getElementById('lateral');
      const velo = document.getElementById('velo');
      const btn = document.getElementById('menu-btn');
      function alternar(abrir) {
        lateral.classList.toggle('abierto', abrir);
        velo.hidden = !abrir;
        btn.setAttribute('aria-expanded', String(abrir));
      }
      btn?.addEventListener('click', () => alternar(!lateral.classList.contains('abierto')));
      velo?.addEventListener('click', () => alternar(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') alternar(false); });
    </script>

    <style>
      body { background: var(--color-sunken); }

      .shell { display: flex; min-height: 100vh; }

      /* ---------------- Sidebar ---------------- */
      .lateral {
        position: fixed;
        inset: 0 auto 0 0;
        width: 16rem;
        background: var(--color-deep);
        color: #fff;
        padding: 1.25rem 0.875rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        z-index: 50;
        transform: translateX(-100%);
        transition: transform 0.22s ease;
        overflow-y: auto;
      }
      .lateral.abierto { transform: translateX(0); }

      .marca {
        display: flex; align-items: center; gap: 0.5rem;
        color: #fff; text-decoration: none;
        font-family: var(--font-display); font-weight: 800; font-size: var(--text-lg);
        padding: 0.25rem 0.625rem;
      }
      .marca-icono { color: var(--color-sun); }

      .grupo {
        font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.12em;
        color: #8b83bd; font-weight: 800; font-family: var(--font-display);
        margin: 0 0 0.5rem 0.625rem;
      }
      nav ul { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.1875rem; }

      .item {
        display: flex; align-items: center; gap: 0.75rem;
        padding: 0.6875rem 0.75rem;
        border-radius: var(--radius-md);
        color: #cfc9ea; text-decoration: none;
        font-weight: 600; font-size: var(--text-sm);
      }
      .item:hover { background: rgb(255 255 255 / 0.08); color: #fff; }
      .item-icono { font-size: 1.0625rem; line-height: 1; }
      /* Active state carries colour AND a left bar, so it never depends on
         colour alone to be legible. */
      .item.activo {
        background: var(--color-primary);
        color: #fff;
        box-shadow: inset 3px 0 0 var(--color-sun);
      }

      .velo {
        position: fixed; inset: 0;
        background: rgb(36 31 61 / 0.5);
        z-index: 45;
      }

      /* ---------------- Main ---------------- */
      .principal { flex: 1; min-width: 0; display: flex; flex-direction: column; }

      .barra {
        position: sticky; top: 0; z-index: 30;
        background: color-mix(in srgb, var(--color-sunken) 92%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-border);
        display: flex; align-items: center; gap: 1rem;
        padding: 0.875rem 1.25rem;
        min-height: 68px;
      }
      .menu-btn {
        background: var(--color-raised);
        border: 2px solid var(--color-border);
        border-radius: var(--radius-md);
        width: 40px; height: 40px;
        cursor: pointer; font-size: 1.125rem;
        color: var(--color-ink);
      }
      .barra-titulo { min-width: 0; }
      .volver { font-size: var(--text-xs); color: var(--color-primary); text-decoration: none; font-weight: 700; }
      .barra h1 {
        font-size: var(--text-xl); margin: 0;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }

      .barra-usuario { margin-left: auto; display: flex; align-items: center; gap: 0.75rem; }
      .usuario-info { display: none; text-align: right; }
      .usuario-nombre { font-family: var(--font-display); font-weight: 800; font-size: var(--text-sm); margin: 0; }
      .usuario-rol { font-size: var(--text-xs); color: var(--color-ink-faint); margin: 0; }
      .avatar {
        width: 2.25rem; height: 2.25rem; flex: none;
        border-radius: var(--radius-pill);
        background: var(--color-primary); color: #fff;
        display: grid; place-items: center;
        font-family: var(--font-display); font-weight: 800;
      }
      .salir {
        background: none; border: none; cursor: pointer;
        color: var(--color-ink-faint); font-size: var(--text-sm);
        font-weight: 700; font-family: var(--font-display);
      }
      .salir:hover { color: var(--color-danger); }

      .contenido { padding: 1.5rem 1.25rem 4rem; flex: 1; }

      /* ---------------- Desktop ---------------- */
      @media (min-width: 900px) {
        .lateral { transform: none; }
        .velo { display: none; }
        .menu-btn { display: none; }
        .principal { margin-left: 16rem; }
        .usuario-info { display: block; }
        .barra { padding-inline: 2rem; }
        .contenido { padding: 2rem 2rem 4rem; }
      }
    </style>
  </body>
</html>
